# MediaGrabber Server Configuration
PORT=3000
MEDIAGRABBER_DATA_DIR="/var/lib/mediagrabber"
MEDIAGRABBER_UPDATE_CHANNEL="nightly"

# Optional signing secret for signed Send-to-Device download links
# MEDIAGRABBER_SIGNING_SECRET=""

# Optional Web Push VAPID keys (auto-generated into data dir if omitted)
# VAPID_SUBJECT="mailto:admin@mediagrabber.local"
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
