app = Flask(__name__)
app.wsgi_app = ProxyFix(app.wsgi_app, x_for=1, x_proto=1, x_host=1, x_prefix=1)

_auth = load_auth()
if _auth:
    app.secret_key = _auth["secret_key"]
else:
    print("\u26a0\ufe0f  No auth configured. Run: python3 app.py set-password")

app.config.update(
    PERMANENT_SESSION_LIFETIME=timedelta(days=7),
    SESSION_COOKIE_HTTPONLY=True,
    # SESSION_COOKIE_SAMESITE removed for Tailscale compatibility
)

@app.before_request
def _enforce_auth():
    if request.endpoint in ("login_page", "login_submit", "static"):
        return None

    conn = sqlite3.connect(USER_DB_PATH)
    has_users = conn.execute("SELECT 1 FROM users LIMIT 1").fetchone()
    conn.close()
    if not has_users:
        return None
    if not session.get("user_id"):
        if request.path == "/" or request.path.startswith("/log/") or request.accept_mimetypes.best_match(["text/html", "application/json"]) == "text/html":
            return redirect(url_for("login_page", next=request.full_path.rstrip("?")))
        return jsonify({"error": "authentication required"}), 401


