def save_settings(data):
    os.makedirs(os.path.dirname(SETTINGS_FILE), exist_ok=True)
    with open(SETTINGS_FILE, "w") as f:
        json.dump(data, f, indent=2)

def update(job_id, key, value):
    with LOCK:
        if job_id in QUEUE:
            QUEUE[job_id][key] = value

def append_log(job_id, line):
    with LOCK:
        if job_id in QUEUE:
            QUEUE[job_id]["log"].append(line)

def scan_for_thumbnail(job):
    if not job:
        return None
    file_path = job.get("file")
    if file_path and os.path.exists(file_path):
        dir_path = os.path.dirname(file_path)
        for root, _, files in os.walk(dir_path):
            for f in files:
                if f.lower().endswith((".jpg", ".jpeg", ".png", ".webp")):
                    return os.path.join(root, f)
    output_dir = job.get("output_dir")
    if output_dir and os.path.exists(output_dir):
        for root, _, files in os.walk(output_dir):
            for f in files:
                if f.lower().endswith((".jpg", ".jpeg", ".png", ".webp")):
                    return os.path.join(root, f)
    return None

def refresh_library(dir_path):
    settings = load_settings()
    jf_url = settings.get("jellyfin_url", "").strip()
    jf_key = settings.get("jellyfin_api_key", "").strip()
    if jf_url:
        try:
            refresh_url = f"{jf_url.rstrip('/')}/Library/Refresh"
            params = {"path": dir_path}
            headers = {"X-Emby-Token": jf_key} if jf_key else {}
            r = requests.post(refresh_url, params=params, headers=headers, timeout=10)
            if r.status_code in (200, 204):
                print(f"✅ Jellyfin refresh triggered for {dir_path}")
            else:
                print(f"⚠️ Jellyfin refresh failed: {r.status_code}")
        except Exception as e:
            print(f"⚠️ Jellyfin error: {e}")
    nav_url = settings.get("navidrome_url", "").strip()
    if nav_url:
        try:
            touch_file = os.path.join(dir_path, ".scan_trigger")
            with open(touch_file, "w") as f:
                f.write(str(time.time()))
            print(f"✅ Navidrome scan triggered (touch file) for {dir_path}")
        except Exception as e:
            print(f"⚠️ Navidrome trigger error: {e}")
    plex_url = settings.get("plex_url", "").strip()
    plex_token = settings.get("plex_token", "").strip()
    plex_section = settings.get("plex_section_id", "").strip()
    if plex_url and plex_token and plex_section:
        try:
            refresh_url = f"{plex_url.rstrip('/')}/library/sections/{plex_section}/refresh"
            params = {"path": dir_path}
            headers = {"X-Plex-Token": plex_token}
            r = requests.put(refresh_url, params=params, headers=headers, timeout=10)
            if r.status_code in (200, 201, 204):
                print(f"✅ Plex refresh triggered for {dir_path}")
            else:
                print(f"⚠️ Plex refresh failed: {r.status_code}")
        except Exception as e:
            print(f"⚠️ Plex error: {e}")

def remove_from_archive(url_or_id):
    if not os.path.exists(ARCHIVE_FILE):
        return
    with open(ARCHIVE_FILE, "r") as f:
        lines = f.readlines()
    new_lines = []
    video_id = None
    if "youtu" in url_or_id:
        match = re.search(r'(?:v=|youtu\.be/|video_id=)([a-zA-Z0-9_-]{11})', url_or_id)
        if match:
            video_id = match.group(1)
    else:
        video_id = url_or_id
    for line in lines:
        line_lower = line.lower()
        if url_or_id.lower() in line_lower:
            continue
        if video_id and video_id in line:
            continue
        new_lines.append(line)
    with open(ARCHIVE_FILE, "w") as f:
        f.writelines(new_lines)

def get_archive_contents():
    if not os.path.exists(ARCHIVE_FILE):
        return []
    with open(ARCHIVE_FILE, "r") as f:
        lines = f.readlines()
    return [line.strip() for line in lines if line.strip()]

def command_exists(cmd):
    return subprocess.call(["which", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0

def get_ffprobe_metadata(file_path, tag):
    try:
        result = subprocess.run(
            ["ffprobe", "-v", "quiet", "-show_entries", f"format_tags={tag}",
             "-of", "default=noprint_wrappers=1:nokey=1", file_path],
            capture_output=True, text=True, timeout=5
        )
        return result.stdout.strip()
    except:
        return ""

# ---------- Metadata endpoints ----------
@app.route("/metadata/<path:path>")
def get_metadata(path):
    full_path = os.path.join("/", path)
    if not os.path.exists(full_path):
        return jsonify({"error": "File not found"}), 404
    base = os.path.splitext(full_path)[0]
    info_file = base + ".info.json"
    if not os.path.exists(info_file):
        return jsonify({"error": "Metadata file not found"}), 404
    try:
        with open(info_file, "r") as f:
            data = json.load(f)
        return jsonify(data)
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route("/metadata/recent")
def get_recent_metadata():
    with LOCK:
        recent = list(QUEUE.items())[-20:]
        result = []
        for job_id, job in recent:
            if job.get("file") and job.get("status") == "done":
                file_path = job["file"]
                base = os.path.splitext(file_path)[0]
                info_file = base + ".info.json"
                if os.path.exists(info_file):
                    try:
                        with open(info_file, "r") as f:
                            info = json.load(f)
                        result.append({
                            "job_id": job_id,
                            "file": file_path,
                            "title": info.get("title"),
                            "uploader": info.get("uploader"),
                            "upload_date": info.get("upload_date"),
                            "thumbnail": job.get("thumbnail")
                        })
                    except:
                        pass
        return jsonify(result)

@app.route("/metadata/scan", methods=["POST"])
def metadata_scan():
    data = request.get_json()
    path = data.get("path")
    if not path or not os.path.isdir(path):
        return jsonify({"error": "Invalid directory"}), 400

    result = []
    for root, dirs, files in os.walk(path):
        for f in files:
            if f.endswith(".info.json"):
                info_path = os.path.join(root, f)
                try:
                    with open(info_path, "r") as fp:
                        info = json.load(fp)
                    base = os.path.splitext(info_path)[0]
                    video_file = None
                    for ext in [".mp4", ".webm", ".mkv"]:
                        candidate = base + ext
                        if os.path.exists(candidate):
                            video_file = candidate
                            break
                    if video_file:
                        result.append({
                            "info_file": info_path,
                            "video_file": video_file,
                            "title": info.get("title", ""),
                            "uploader": info.get("uploader", ""),
                            "upload_date": info.get("upload_date", ""),
                            "description": info.get("description", ""),
                            "tags": info.get("tags", [])
                        })
                except Exception as e:
                    pass
    return jsonify(result)

@app.route("/metadata/update", methods=["POST"])
def metadata_update():
    data = request.get_json()
    info_file = data.get("info_file")
    if not info_file or not os.path.exists(info_file):
        return jsonify({"error": "Invalid info file"}), 400

    try:
        with open(info_file, "r") as f:
            info = json.load(f)
    except:
        return jsonify({"error": "Unable to read info file"}), 500

    if "title" in data:
        info["title"] = data["title"]
    if "uploader" in data:
        info["uploader"] = data["uploader"]
    if "upload_date" in data:
        info["upload_date"] = data["upload_date"]
    if "description" in data:
        info["description"] = data["description"]
    if "tags" in data:
        info["tags"] = data["tags"]

    try:
        with open(info_file, "w") as f:
            json.dump(info, f, indent=2)
    except:
        return jsonify({"error": "Unable to write info file"}), 500

    dir_path = os.path.dirname(info_file)
    refresh_library(dir_path)

    return jsonify({"status": "updated"})

@app.route("/refresh/<path:path>", methods=["POST"])
def refresh_path(path):
    full_path = os.path.join("/", path)
    if not os.path.exists(full_path):
        return jsonify({"error": "File not found"}), 404
    dir_path = os.path.dirname(full_path)
    refresh_library(dir_path)
    return jsonify({"status": "refreshed", "path": dir_path})

# ---------- Archive Manager ----------
@app.route("/archive", methods=["GET"])
def get_archive():
    entries = get_archive_contents()
    result = []
    for entry in entries:
        video_id = None
        if "youtu" in entry:
            match = re.search(r'(?:v=|youtu\.be/|video_id=)([a-zA-Z0-9_-]{11})', entry)
            if match:
                video_id = match.group(1)
        result.append({
            "entry": entry,
            "video_id": video_id if video_id else entry[:20] + "..."
        })
    return jsonify(result)

@app.route("/archive/delete", methods=["POST"])
def delete_archive_entry():
    data = request.get_json()
    entry = data.get("entry")
    if not entry:
        return jsonify({"error": "No entry provided"}), 400
    remove_from_archive(entry)
    return jsonify({"status": "deleted"})

# ---------- Grab endpoint ----------
@app.route("/grab", methods=["POST"])
def grab():
    url = request.form["url"]
    mode = request.form.get("mode", "video")
    job_id = str(uuid.uuid4())
    with LOCK:
        QUEUE[job_id] = {
            "url": url,
            "status": "queued",
            "progress": 0,
            "file": None,
            "thumbnail": None,
            "output_dir": None,
            "log": [],
            "job_id": job_id
        }
    def run():
        update(job_id, "status", "running")
        job = QUEUE[job_id]
        job["output_dir"] = f"/tmp/mediagrabber/{job_id}"
        os.makedirs(job["output_dir"], exist_ok=True)

        settings = load_settings()
        env = os.environ.copy()
        env["GRAB_OUTPUT_DIR"] = job["output_dir"]
        env["GRAB_YT_DIR"] = settings.get("yt_base_path", DEFAULT_YT_DIR)
        env["GRAB_MUSIC_DIR"] = settings.get("music_base_path", DEFAULT_MUSIC_DIR)
        env["GRAB_GALLERY_DIR"] = settings.get("gallery_base_path", DEFAULT_GALLERY_DIR)
        env["GRAB_COOKIES_YOUTUBE"] = settings.get("cookies_youtube_path", "")
        env["GRAB_COOKIES_GALLERY"] = settings.get("cookies_gallery_path", "")
        env["GRAB_VIDEO_RES"] = settings.get("video_res", "1080")
        env["GRAB_AUDIO_FORMAT"] = settings.get("audio_format", "mp3")
        env["GRAB_AUDIO_BITRATE"] = settings.get("audio_bitrate", "320k")
        env["GRAB_CONTAINER"] = settings.get("container", "mp4")
        env["GRAB_GENERATE_LRC"] = "true" if settings.get("generate_lrc", False) else "false"
        if mode == "audio":
            env["GRAB_AUDIO_ONLY"] = "true"
        else:
            env["GRAB_AUDIO_ONLY"] = "false"

        extra_yt = (settings.get("ytdlp_extra") or "").strip()
        if mode != "audio":
            if "-S vcodec:" not in extra_yt and "--format-sort" not in extra_yt:
                extra_yt = (extra_yt + " -S vcodec:h264,res,br").strip()
        if extra_yt:
            env["GRAB_EXTRA_YT"] = extra_yt
        if settings.get("spotdl_extra"):
            env["GRAB_EXTRA_SPOTIFY"] = settings["spotdl_extra"]
        if settings.get("gallerydl_extra"):
            env["GRAB_EXTRA_GALLERY"] = settings["gallerydl_extra"]

        proc = subprocess.Popen(
            ["grab", url],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            env=env
        )
        with LOCK:
            PROCESSES[job_id] = proc

        last_progress = 0
        gallery_download_started = False
        engine = "UNKNOWN"

        for line in proc.stdout:
            line = line.strip()
            append_log(job_id, line)

            if "Engine → SPOTIFY" in line:
                engine = "SPOTIFY"
            elif "Engine → GALLERY" in line:
                engine = "GALLERY"
            elif "Engine → YOUTUBE" in line:
                engine = "YOUTUBE"

            if "[download]" in line and "%" in line:
                m = re.search(r'(\d{1,3}(?:\.\d+)?)%', line)
                if m:
                    try:
                        val = float(m.group(1))
                        if val >= last_progress:
                            last_progress = val
                            update(job_id, "progress", val)
                    except:
                        pass

            if "PROGRESS:" in line:
                m = re.search(r'PROGRESS:\s*(\d+)/(\d+)\s*(?:\((\d+)%\))?', line)
                if m:
                    downloaded = int(m.group(1))
                    total = int(m.group(2))
                    if total > 0:
                        progress = int(m.group(3)) if m.group(3) else (downloaded / total) * 100
                        if progress >= last_progress:
                            last_progress = progress
                            update(job_id, "progress", progress)

            if engine == "GALLERY" and "Downloading" in line:
                if not gallery_download_started:
                    gallery_download_started = True
                    update(job_id, "progress", 50)

            if "FINAL_FILE:" in line:
                final_file = line.split("FINAL_FILE:", 1)[1].strip()
                update(job_id, "file", final_file)
            if "FINAL_THUMB:" in line:
                final_thumb = line.split("FINAL_THUMB:", 1)[1].strip()
                update(job_id, "thumbnail", final_thumb)

        proc.wait()
        with LOCK:
            if job_id in PROCESSES:
                del PROCESSES[job_id]

        if engine == "GALLERY" and not QUEUE[job_id].get("file"):
            update(job_id, "progress", 100)

        if not QUEUE[job_id].get("file"):
            files = []
            for root, _, f in os.walk(job["output_dir"]):
                for file in f:
                    if file.lower().endswith((".mp4", ".webm", ".mkv", ".mp3", ".flac", ".m4a")):
                        files.append(os.path.join(root, file))
            if files:
                update(job_id, "file", max(files, key=os.path.getctime))

        thumb = scan_for_thumbnail(QUEUE[job_id])
        if thumb:
            update(job_id, "thumbnail", thumb)

        if QUEUE[job_id].get("file"):
            update(job_id, "status", "done")
            update(job_id, "progress", 100)
            refresh_library(os.path.dirname(QUEUE[job_id]["file"]))
        else:
            if proc.returncode != 0:
                update(job_id, "status", "failed")
                update(job_id, "progress", 0)
            else:
                update(job_id, "status", "done")
                update(job_id, "progress", 100)

    threading.Thread(target=run, daemon=True).start()
    return jsonify({"job_id": job_id})

# ---------- Retry endpoint ----------
@app.route("/retry/<job_id>", methods=["POST"])
def retry_job(job_id):
    with LOCK:
        job = QUEUE.get(job_id)
        if not job:
            return jsonify({"error": "Job not found"}), 404
        url = job.get("url")
        if job_id in QUEUE:
            del QUEUE[job_id]
        if url:
            remove_from_archive(url)
    with app.test_request_context('/grab', method='POST', data={'url': url}):
        resp = app.full_dispatch_request()
        if resp.status_code == 200:
            data = resp.get_json()
            return jsonify({"status": "retried", "new_job_id": data.get("job_id")})
        else:
            return jsonify({"error": "Failed to retry"}), 500

# ---------- Clear Archive (from queue) ----------
@app.route("/clear-archive/<job_id>", methods=["POST"])
def clear_archive(job_id):
    with LOCK:
        job = QUEUE.get(job_id)
        if not job:
            return jsonify({"error": "Job not found"}), 404
        url = job.get("url")
        if url:
            remove_from_archive(url)
            append_log(job_id, "🗑️ Archive entry removed")
            status = job.get("status")
            if status in ("done", "failed", "cancelled"):
                del QUEUE[job_id]
                return jsonify({"status": "archive cleared and job removed"})
            return jsonify({"status": "archive cleared"})
        return jsonify({"error": "No URL found"}), 400

# ---------- Cancel / Remove / Clear ----------
@app.route("/cancel/<job_id>", methods=["POST"])
def cancel_job(job_id):
    with LOCK:
        if job_id in PROCESSES:
            try:
                PROCESSES[job_id].terminate()
                append_log(job_id, "🛑 Job cancelled by user")
                time.sleep(1)
                if PROCESSES[job_id].poll() is None:
                    PROCESSES[job_id].kill()
            except Exception as e:
                append_log(job_id, f"⚠️ Cancel error: {e}")
            finally:
                if job_id in PROCESSES:
                    del PROCESSES[job_id]
        if job_id in QUEUE:
            QUEUE[job_id]["status"] = "cancelled"
            QUEUE[job_id]["progress"] = 0
    return jsonify({"status": "cancelled"})

@app.route("/remove/<job_id>", methods=["DELETE"])
def remove_job(job_id):
    with LOCK:
        if job_id in QUEUE:
            if job_id in PROCESSES:
                try:
                    PROCESSES[job_id].terminate()
                except:
                    pass
                finally:
                    if job_id in PROCESSES:
                        del PROCESSES[job_id]
            del QUEUE[job_id]
    return jsonify({"status": "removed"})

@app.route("/clear-completed", methods=["POST"])
def clear_completed():
    with LOCK:
        to_remove = [jid for jid, job in QUEUE.items() if job.get("status") in ("done", "failed", "cancelled")]
        for jid in to_remove:
            if jid in PROCESSES:
                try:
                    PROCESSES[jid].terminate()
                except:
                    pass
                finally:
                    if jid in PROCESSES:
                        del PROCESSES[jid]
            del QUEUE[jid]
    return jsonify({"status": "cleared"})

# ---------- Reorganize ----------
@app.route("/reorganize", methods=["POST"])
def reorganize():
    global REORG_RUNNING, REORG_LOGS, REORG_MOVED_DIRS
    with REORG_LOCK:
        if REORG_RUNNING:
            return jsonify({"status": "already running"}), 400
        REORG_RUNNING = True
        REORG_LOGS = []
        REORG_MOVED_DIRS = []
    def run_reorg():
        global REORG_RUNNING, REORG_LOGS, REORG_MOVED_DIRS
        try:
            settings = load_settings()
            env = os.environ.copy()
            env["REORG_YT_DIR"] = settings.get("yt_base_path", DEFAULT_YT_DIR)
            env["REORG_MUSIC_DIR"] = settings.get("music_base_path", DEFAULT_MUSIC_DIR)
            env["REORG_GALLERY_DIR"] = settings.get("gallery_base_path", DEFAULT_GALLERY_DIR)
            proc = subprocess.Popen(
                ["/usr/local/bin/reorganize-youtube"],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                env=env
            )
            for line in proc.stdout:
                line = line.strip()
                with REORG_LOCK:
                    REORG_LOGS.append(line)
                    if line.startswith("MOVED_TO:"):
                        moved_dir = line.split("MOVED_TO:", 1)[1].strip()
                        if moved_dir not in REORG_MOVED_DIRS:
                            REORG_MOVED_DIRS.append(moved_dir)
                time.sleep(0.1)
            proc.wait()
        except Exception as e:
            with REORG_LOCK:
                REORG_LOGS.append(f"❌ Error: {e}")
        finally:
            with REORG_LOCK:
                REORG_RUNNING = False
                for dir_path in REORG_MOVED_DIRS:
                    refresh_library(dir_path)
                refresh_library("/media/YouTube")
    threading.Thread(target=run_reorg, daemon=True).start()
    return jsonify({"status": "started"})

@app.route("/reorganize-logs")
def reorganize_logs():
    with REORG_LOCK:
        return jsonify({
            "running": REORG_RUNNING,
            "logs": REORG_LOGS[-200:]
        })

# ---------- Deduplicate ----------
@app.route("/deduplicate", methods=["POST"])
def deduplicate():
    data = request.get_json()
    target = data.get("target")
    action = data.get("action", "scan")
    if not target or not os.path.isdir(target):
        return jsonify({"error": "Invalid target directory"}), 400

    def run_dedup():
        import subprocess as sp
        cmd = ["/usr/local/bin/deduplicate-files", "--target", target, "--action", action]
        proc = sp.Popen(cmd, stdout=sp.PIPE, stderr=sp.STDOUT, text=True)
        for line in proc.stdout:
            yield line.strip()
        proc.wait()

    from flask import Response
    return Response(run_dedup(), mimetype='text/plain')

# ---------- Tmp Reorder ----------
@app.route("/tmp-reorder", methods=["POST"])
def tmp_reorder():
    global TMP_REORG_LOGS, TMP_REORG_RUNNING
    with TMP_REORG_LOCK:
        if TMP_REORG_RUNNING:
            return jsonify({"status": "already running"}), 400
        TMP_REORG_RUNNING = True
        TMP_REORG_LOGS = []
    def run_tmp_reorg():
        global TMP_REORG_RUNNING, TMP_REORG_LOGS
        try:
            settings = load_settings()
            env = os.environ.copy()
            env["REORG_YT_DIR"] = settings.get("yt_base_path", DEFAULT_YT_DIR)
            env["REORG_MUSIC_DIR"] = settings.get("music_base_path", DEFAULT_MUSIC_DIR)
            env["REORG_GALLERY_DIR"] = settings.get("gallery_base_path", DEFAULT_GALLERY_DIR)
            proc = subprocess.Popen(
                ["/usr/local/bin/tmp-reorder"],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                env=env
            )
            for line in proc.stdout:
                line = line.strip()
                with TMP_REORG_LOCK:
                    TMP_REORG_LOGS.append(line)
                    if line.startswith("MOVED_TO:"):
                        moved_dir = line.split("MOVED_TO:", 1)[1].strip()
                        refresh_library(moved_dir)
                time.sleep(0.1)
            proc.wait()
        except Exception as e:
            with TMP_REORG_LOCK:
                TMP_REORG_LOGS.append(f"❌ Error: {e}")
        finally:
            with TMP_REORG_LOCK:
                TMP_REORG_RUNNING = False
    threading.Thread(target=run_tmp_reorg, daemon=True).start()
    return jsonify({"status": "started"})

@app.route("/tmp-reorder-logs")
def tmp_reorder_logs():
    with TMP_REORG_LOCK:
        return jsonify({
            "running": TMP_REORG_RUNNING,
            "logs": TMP_REORG_LOGS[-200:]
        })

# ---------- Radio Manager (Navidrome `radio` table) ----------

RADIO_DB_PATH = "/var/lib/navidrome/navidrome.db"

def get_db_connection():
    conn = sqlite3.connect(RADIO_DB_PATH, timeout=15)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA busy_timeout = 15000")
    return conn

def _now_navidrome():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f") + "000Z"

def _radio_table_exists(conn):
    cur = conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='radio' LIMIT 1"
    )
    return cur.fetchone() is not None

@app.route("/radio/status", methods=["GET"])
def radio_status():
    if not os.path.exists(RADIO_DB_PATH):
        return jsonify({"installed": False,
                        "message": f"DB not found: {RADIO_DB_PATH}"}), 500
    try:
        conn = get_db_connection()
        ok = _radio_table_exists(conn)
        n = 0
        if ok:
            n = conn.execute("SELECT COUNT(*) FROM radio").fetchone()[0]
        conn.close()
        if not ok:
            return jsonify({"installed": False,
                            "message": "Navidrome 'radio' table missing"}), 500
        return jsonify({"installed": True,
                        "message": f"Connected — {n} stations in Navidrome"})
    except Exception as e:
        return jsonify({"installed": False, "message": f"DB error: {e}"}), 500

@app.route("/radio/search", methods=["POST"])
def radio_search():
    data = request.get_json(silent=True) or {}
    query = (data.get("query") or "").strip()
    search_type = data.get("type", "name")
    page = max(int(data.get("page", 1) or 1), 1)
    limit = 50
    offset = (page - 1) * limit

    if not query:
        return jsonify({"error": "Search query required"}), 400

    endpoints = {"name": "byname", "genre": "bytag", "country": "bycountry"}
    if search_type not in endpoints:
        return jsonify({"error": "Invalid search type"}), 400

    try:
        url = f"https://de1.api.radio-browser.info/json/stations/{endpoints[search_type]}/{query}"
        r = requests.get(url, params={"limit": limit, "offset": offset,
                                      "hidebroken": "true"},
                         timeout=15,
                         headers={"User-Agent": "MediaGrabber/44"})
        if r.status_code != 200:
            return jsonify({"error": "Radio-Browser API error",
                            "details": r.text[:300]}), 502
        stations = []
        for item in r.json():
            stream = item.get("url_resolved") or item.get("url") or ""
            if not stream:
                continue
            stations.append({
                "name": item.get("name", "Unknown"),
                "url": stream,
                "country": item.get("country", ""),
                "homepage": item.get("homepage", ""),
                "favicon": item.get("favicon", ""),
            })
        return jsonify({
            "stations": stations,
            "page": page,
            "has_next": len(stations) == limit,
            "total": (page - 1) * limit + len(stations),
        })
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route("/radio/add", methods=["POST"])
def radio_add():
    data = request.get_json(silent=True) or {}
    url = (data.get("url") or "").strip()
    name = (data.get("name") or "").strip()
    homepage = (data.get("homepage") or "").strip()

    if not url:
        return jsonify({"error": "Stream URL is required"}), 400
    if not name:
        name = urlparse(url).netloc or url

    now = _now_navidrome()
    try:
        conn = get_db_connection()
        if not _radio_table_exists(conn):
            conn.close()
            return jsonify({"error": "Navidrome 'radio' table not found"}), 500

        if conn.execute("SELECT 1 FROM radio WHERE stream_url = ?", (url,)).fetchone():
            conn.close()
            return jsonify({"error": "That stream URL is already in Navidrome"}), 400

        if conn.execute("SELECT 1 FROM radio WHERE name = ?", (name,)).fetchone():
            conn.close()
            return jsonify({"error": f"A station named '{name}' already exists"}), 400

        conn.execute(
            "INSERT INTO radio (id, name, stream_url, home_page_url,"
            " created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?)",
            (str(uuid.uuid4()), name, url, homepage, now, now),
        )
        conn.commit()
        conn.close()
    except sqlite3.IntegrityError as e:
        return jsonify({"error": f"Constraint violation: {e}"}), 400
    except sqlite3.OperationalError as e:
        return jsonify({"error": f"DB busy/locked: {e}"}), 503
    except Exception as e:
        return jsonify({"error": str(e)}), 500

    return jsonify({"status": "success",
                    "message": f"Radio '{name}' added — appears in Navidrome after its next radio refresh"})

@app.route("/radio/list", methods=["GET"])
def radio_list():
    try:
        conn = get_db_connection()
        if not _radio_table_exists(conn):
            conn.close()
            return jsonify({"error": "Navidrome 'radio' table not found"}), 500
        rows = conn.execute(
            "SELECT id, name, stream_url, home_page_url FROM radio ORDER BY name"
        ).fetchall()
        conn.close()
        return jsonify({"stations": [
            {"id": r["id"], "name": r["name"], "url": r["stream_url"],
             "homepage": r["home_page_url"]} for r in rows
        ]})
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route("/radio/remove", methods=["POST"])
def radio_remove():
    data = request.get_json(silent=True) or {}
    url = (data.get("url") or "").strip()
    rid = (data.get("id") or "").strip()
    if not url and not rid:
        return jsonify({"error": "Provide stream URL or station id"}), 400
    try:
        conn = get_db_connection()
        if rid:
            cur = conn.execute("DELETE FROM radio WHERE id = ?", (rid,))
        else:
            cur = conn.execute("DELETE FROM radio WHERE stream_url = ?", (url,))
        conn.commit()
        deleted = cur.rowcount
        conn.close()
        if not deleted:
            return jsonify({"error": "Station not found"}), 404
        return jsonify({"status": "success", "message": "Station removed"})
    except sqlite3.OperationalError as e:
        return jsonify({"error": f"DB busy/locked: {e}"}), 503
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route("/radio/setdb", methods=["POST"])
def radio_setdb():
    global RADIO_DB_PATH
    data = request.get_json(silent=True) or {}
    db_path = (data.get("db_path") or "").strip()
    if not db_path or not os.path.isfile(db_path):
        return jsonify({"error": "Not a file"}), 400
    old = RADIO_DB_PATH
    RADIO_DB_PATH = db_path
    try:
        conn = get_db_connection()
        ok = _radio_table_exists(conn)
        conn.close()
    except Exception as e:
        RADIO_DB_PATH = old
        return jsonify({"error": f"Cannot open: {e}"}), 500
    if not ok:
        RADIO_DB_PATH = old
        return jsonify({"error": "No 'radio' table in that DB"}), 400
    return jsonify({"status": "success", "message": f"Database path set to {db_path}"})

# ---------- Auth routes ----------
@app.route("/login", methods=["GET"])
def login_page():
    if session.get("user_id"):
        return redirect("/")
    if session.get("user"):
        session.clear()  # Clean up stale old-auth session

    nxt = request.args.get("next", "/")
    if not nxt.startswith("/") or nxt.startswith("//"):
        nxt = "/"
    return render_template_string(LOGIN_TEMPLATE, error=None, next=nxt, require_2fa=False, username="")

@app.route("/login", methods=["POST"])
def login_submit():
    username = (request.form.get("username") or "").strip()
    password = request.form.get("password") or ""
    totp_code = request.form.get("totp")
    nxt = request.form.get("next") or "/"
    
    if not nxt.startswith("/") or nxt.startswith("//"):
        nxt = "/"
        
    ip = request.remote_addr or "?"
    now = time.time()
    
    with LOGIN_LOCK:
        attempts = [t for t in LOGIN_ATTEMPTS.get(ip, []) if now - t < LOGIN_LOCKOUT_SECONDS]
        LOGIN_ATTEMPTS[ip] = attempts
        if len(attempts) >= MAX_LOGIN_ATTEMPTS:
            return render_template_string(LOGIN_TEMPLATE, error="Too many failed attempts.", next=nxt, require_2fa=False, username=""), 429

    # If they are submitting a 2FA code
    if totp_code:
        user = get_user(username)
        if user and user.get("totp_secret"):
            totp = pyotp.TOTP(user["totp_secret"])
            if totp.verify(totp_code):
                session.clear()
                session["user_id"] = user["id"]
                session["username"] = user["username"]
                session["role"] = user["role"]
                session.permanent = True
                return redirect(nxt)
        return render_template_string(LOGIN_TEMPLATE, error="Invalid 2FA code.", next=nxt, require_2fa=True, username=username), 401

    # Step 1: Password Check
    user = get_user(username)
    
    is_valid = False
    if user and check_password_hash(user["password_hash"], password):
        is_valid = True

    if is_valid:
        if user.get("totp_secret"):
            return render_template_string(LOGIN_TEMPLATE, error=None, next=nxt, require_2fa=True, username=username)
        else:
            session.clear()
            session["user_id"] = user["id"]
            session["username"] = user["username"]
            session["role"] = user["role"]
            session.permanent = True
            return redirect(nxt)
            
    with LOGIN_LOCK:
        LOGIN_ATTEMPTS.setdefault(ip, []).append(now)
        
    return render_template_string(LOGIN_TEMPLATE, error="Invalid username or password.", next=nxt, require_2fa=False, username=""), 401

@app.route("/logout", methods=["GET", "POST"])
def logout():
    session.clear()
    return redirect("/login")



@app.route("/api/theme", methods=["POST"])
def save_theme():
    if not session.get("user_id"):
        return jsonify({"error": "Unauthorized"}), 401
    
    data = request.json
    colors = data.get("colors", {})
    
    conn = sqlite3.connect(USER_DB_PATH)
    conn.execute("UPDATE users SET theme_colors = ? WHERE id = ?", (json.dumps(colors), session["user_id"]))
    conn.commit()
    conn.close()
    return jsonify({"success": True})

@app.route("/api/me", methods=["GET"])
def api_me():
    if not session.get("user_id"): return jsonify({"error": "Unauthorized"}), 401
    user = get_user_by_id(session["user_id"])
    if not user: return jsonify({"error": "User not found"}), 404
    user.pop("password_hash", None)
    user.pop("reset_token", None)
    return jsonify(user)

@app.route("/api/me/update", methods=["POST"])
def api_me_update():
    if not session.get("user_id"): return jsonify({"error": "Unauthorized"}), 401
    data = request.form
    display_name = data.get("display_name", "").strip()
    email = data.get("email", "").strip()
    new_password = data.get("new_password", "")
    theme = data.get("theme", "")
    conn = sqlite3.connect(USER_DB_PATH)
    avatar_file = request.files.get("avatar")
    if avatar_file and avatar_file.filename:
        ext = os.path.splitext(avatar_file.filename)[1].lower()
        if ext in [".jpg", ".jpeg", ".png", ".gif", ".webp"]:
            filename = f"user_{session['user_id']}{ext}"
            avatar_file.save(os.path.join(AVATAR_DIR, filename))
            conn.execute("UPDATE users SET avatar = ? WHERE id = ?", (filename, session["user_id"]))
    if display_name: conn.execute("UPDATE users SET display_name = ? WHERE id = ?", (display_name, session["user_id"]))
    if email: conn.execute("UPDATE users SET email = ? WHERE id = ?", (email, session["user_id"]))
    if theme: conn.execute("UPDATE users SET theme = ? WHERE id = ?", (theme, session["user_id"]))
    if new_password:
        if len(new_password) < 8: return jsonify({"error": "Password must be at least 8 characters"}), 400
        conn.execute("UPDATE users SET password_hash = ? WHERE id = ?", (generate_password_hash(new_password), session["user_id"]))
    
    # Admin SMTP Settings
    if session.get("role") == "admin" and "smtp_host" in request.form:
        s = load_settings()
        s["smtp_host"] = request.form.get("smtp_host", "")
        s["smtp_port"] = request.form.get("smtp_port", "")
        s["smtp_user"] = request.form.get("smtp_user", "")
        s["smtp_pass"] = request.form.get("smtp_pass", "")
        s["smtp_from"] = request.form.get("smtp_from", "")
        save_settings(s)
    conn.commit()
    conn.close()
    return jsonify({"status": "success"})


def send_reset_email(to_email, reset_url):
    settings = load_settings()
    host = settings.get("smtp_host", "").strip()
    if not host:
        return False, "SMTP is not configured by the administrator."

    port = int(settings.get("smtp_port", 587))
    user = settings.get("smtp_user", "").strip()
    password = settings.get("smtp_pass", "").strip()
    from_addr = settings.get("smtp_from", "").strip() or user or "noreply@mediagrabber.local"

    msg = MIMEMultipart()
    msg['From'] = from_addr
    msg['To'] = to_email
    msg['Subject'] = "MediaGrabber Password Reset"

    body = f"""
    <html>
    <body style="font-family: sans-serif; background: #0f0f11; color: #eaeef2; padding: 20px;">
        <h2 style="color: #5b7cfa;">MediaGrabber Password Reset</h2>
        <p>A password reset was requested for your account.</p>
        <p>Click the button below to reset your password. This link expires in 1 hour.</p>
        <a href="{reset_url}" style="display: inline-block; padding: 12px 24px; background: #5b7cfa; color: #fff; text-decoration: none; border-radius: 6px; margin-top: 10px; font-weight: bold;">Reset Password</a>
        <p style="margin-top: 20px; font-size: 0.8rem; color: #8899aa;">If you did not request this, you can safely ignore this email.</p>
    </body>
    </html>
    """
    msg.attach(MIMEText(body, 'html'))

    try:
        if port == 465:
            server = smtplib.SMTP_SSL(host, port, timeout=10)
        else:
            server = smtplib.SMTP(host, port, timeout=10)
            server.starttls()
        
        if user and password:
            server.login(user, password)
        
        server.send_message(msg)
        server.quit()
        return True, "Email sent successfully."
    except Exception as e:
        print(f"SMTP Error: {e}")
        return False, f"Failed to send email: {str(e)}"

@app.route("/api/me/reset-request", methods=["POST"])
def api_me_reset_request():
    if not session.get("user_id"): return jsonify({"error": "Unauthorized"}), 401
    user = get_user_by_id(session["user_id"])
    if not user or not user.get("email"): return jsonify({"error": "No email configured on account"}), 400
    token = secrets.token_urlsafe(32)
    conn = sqlite3.connect(USER_DB_PATH)
    conn.execute("UPDATE users SET reset_token = ?, reset_expires = ? WHERE id = ?", (token, time.time() + 3600, user["id"]))
    conn.commit()
    conn.close()
    print(f"\n\U0001F511 PASSWORD RESET LINK: {url_for('reset_password', token=token, _external=True)}\n")
    return jsonify({"status": "success", "message": "Reset link printed to server log."})

@app.route("/avatars/<filename>")
def serve_avatar(filename):
    return send_from_directory(AVATAR_DIR, filename)

@app.route("/reset/<token>", methods=["GET", "POST"])
def reset_password(token):
    conn = sqlite3.connect(USER_DB_PATH)
    conn.row_factory = sqlite3.Row
    user = conn.execute("SELECT * FROM users WHERE reset_token = ? AND reset_expires > ?", (token, time.time())).fetchone()
    if not user:
        conn.close()
        return "Invalid or expired reset link.", 400
    if request.method == "POST":
        new_pw = request.form.get("password", "")
        if len(new_pw) < 8: return "Password must be at least 8 characters.", 400
        conn.execute("UPDATE users SET password_hash = ?, reset_token = NULL, reset_expires = NULL WHERE id = ?", (generate_password_hash(new_pw), user["id"]))
        conn.commit()
        conn.close()
        return "Password reset successfully. You can now <a href='/login'>login</a>."
    conn.close()
    return """<form method="POST"><h2>Reset Password</h2><input type="password" name="password" placeholder="New password" required><button type="submit">Reset</button></form>"""


@app.route("/api/users", methods=["GET"])
def api_get_users():
    if session.get("role") != "admin": return jsonify({"error": "Admin access required"}), 403
    conn = sqlite3.connect(USER_DB_PATH)
    conn.row_factory = sqlite3.Row
    users = conn.execute("SELECT id, username, display_name, role, email, totp_secret FROM users").fetchall()
    conn.close()
    return jsonify([dict(u) for u in users])

@app.route("/api/users/add", methods=["POST"])
def api_add_user():
    if session.get("role") != "admin": return jsonify({"error": "Admin access required"}), 403
    data = request.get_json()
    username = data.get("username", "").strip()
    password = data.get("password", "")
    role = data.get("role", "user")
    
    if not username or not password: return jsonify({"error": "Username and password required"}), 400
    if len(password) < 8: return jsonify({"error": "Password must be at least 8 characters"}), 400
    
    conn = sqlite3.connect(USER_DB_PATH)
    try:
        conn.execute(
            "INSERT INTO users (username, password_hash, display_name, role) VALUES (?, ?, ?, ?)",
            (username, generate_password_hash(password), username, role)
        )
        conn.commit()
    except sqlite3.IntegrityError:
        return jsonify({"error": "Username already exists"}), 400
    finally:
        conn.close()
    return jsonify({"status": "success"})

@app.route("/api/users/remove", methods=["POST"])
def api_remove_user():
    if session.get("role") != "admin": return jsonify({"error": "Admin access required"}), 403
    data = request.get_json()
    user_id = data.get("id")
    
    if user_id == session.get("user_id"):
        return jsonify({"error": "You cannot delete your own account"}), 400
        
    conn = sqlite3.connect(USER_DB_PATH)
    conn.execute("DELETE FROM users WHERE id = ?", (user_id,))
    conn.commit()
    conn.close()
    return jsonify({"status": "success"})


@app.route("/api/me/2fa/setup", methods=["POST"])
def setup_2fa():
    if not session.get("user_id"): return jsonify({"error": "Unauthorized"}), 401
    user = get_user_by_id(session["user_id"])
    
    secret = pyotp.random_base32()
    totp = pyotp.TOTP(secret)
    provisioning_url = totp.provisioning_uri(name=user["username"], issuer_name="MediaGrabber")
    
    return jsonify({"secret": secret, "url": provisioning_url})

@app.route("/api/me/2fa/enable", methods=["POST"])
def enable_2fa():
    if not session.get("user_id"): return jsonify({"error": "Unauthorized"}), 401
    data = request.get_json()
    secret = data.get("secret")
    code = data.get("code")
    
    totp = pyotp.TOTP(secret)
    if totp.verify(code):
        conn = sqlite3.connect(USER_DB_PATH)
        conn.execute("UPDATE users SET totp_secret = ? WHERE id = ?", (secret, session["user_id"]))
        conn.commit()
        conn.close()
        return jsonify({"status": "success"})
    return jsonify({"error": "Invalid code"}), 400

@app.route("/api/me/2fa/disable", methods=["POST"])
def disable_2fa():
    if not session.get("user_id"): return jsonify({"error": "Unauthorized"}), 401
    conn = sqlite3.connect(USER_DB_PATH)
    conn.execute("UPDATE users SET totp_secret = NULL WHERE id = ?", (session["user_id"],))
    conn.commit()
    conn.close()
    return jsonify({"status": "success"})

