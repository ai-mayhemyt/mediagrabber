# ---------- User Database & Auth ----------
AUTH_FILE = "/opt/mediagrabber/auth.json"
USER_DB_PATH = "/opt/mediagrabber/users.db"
AVATAR_DIR = "/opt/mediagrabber/avatars"
os.makedirs(AVATAR_DIR, exist_ok=True)

def init_user_db():
    conn = sqlite3.connect(USER_DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("""CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        username TEXT UNIQUE NOT NULL,
        password_hash TEXT NOT NULL,
        display_name TEXT,
        role TEXT DEFAULT 'user',
        avatar TEXT,
        email TEXT,
        reset_token TEXT,
        reset_expires REAL,
        theme TEXT DEFAULT 'dark',
        totp_secret TEXT
    )""")
    try:
        conn.execute("ALTER TABLE users ADD COLUMN totp_secret TEXT")
    except sqlite3.OperationalError:
        pass
    try:
        conn.execute("ALTER TABLE users ADD COLUMN theme TEXT DEFAULT 'dark'")
    except sqlite3.OperationalError:
        pass
    conn.commit()
    
    if conn.execute("SELECT COUNT(*) FROM users").fetchone()[0] == 0:
        old_auth = load_auth_json()
        if old_auth:
            conn.execute(
                "INSERT INTO users (username, password_hash, display_name, role) VALUES (?, ?, ?, ?)",
                (old_auth["username"], old_auth["password_hash"], old_auth["username"], "admin")
            )
        else:
            conn.execute(
                "INSERT INTO users (username, password_hash, display_name, role) VALUES (?, ?, ?, ?)",
                ("admin", generate_password_hash("admin"), "Administrator", "admin")
            )
        conn.commit()
    conn.close()

def load_auth_json():
    try:
        with open(AUTH_FILE, "r") as f:
            return json.load(f)
    except:
        return None

def get_user(username):
    conn = sqlite3.connect(USER_DB_PATH)
    conn.row_factory = sqlite3.Row
    row = conn.execute("SELECT * FROM users WHERE username = ?", (username,)).fetchone()
    conn.close()
    return dict(row) if row else None

def get_user_by_id(uid):
    conn = sqlite3.connect(USER_DB_PATH)
    conn.row_factory = sqlite3.Row
    row = conn.execute("SELECT * FROM users WHERE id = ?", (uid,)).fetchone()
    conn.close()
    return dict(row) if row else None

init_user_db()

AUTH_FILE = "/opt/mediagrabber/auth.json"
LOGIN_ATTEMPTS = {}
LOGIN_LOCK = threading.Lock()
MAX_LOGIN_ATTEMPTS = 5
LOGIN_LOCKOUT_SECONDS = 900

def load_auth():
    try:
        with open(AUTH_FILE, "r") as f:
            return json.load(f)
    except FileNotFoundError:
        return None
    except Exception as e:
        print(f"\u26a0\ufe0f  Cannot read auth file: {e}")
        return None

def save_auth(data):
    os.makedirs(os.path.dirname(AUTH_FILE), exist_ok=True)
    tmp = AUTH_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, AUTH_FILE)
    try:
        os.chmod(AUTH_FILE, 0o600)
    except OSError:
        pass

def _auth_required():
    endpoint = request.endpoint or ""
    if endpoint in ("login_page", "login_submit", "logout", "static"):
        return None
    if load_auth() is None:
        return None
    if session.get("user"):
        return None
    accept = request.accept_mimetypes.best_match(["text/html", "application/json", "*/*"])
    if request.path == "/" or request.path.startswith("/log/") or accept == "text/html":
        return redirect(url_for("login_page", next=request.full_path.rstrip("?")))
    return jsonify({"error": "authentication required"}), 401

