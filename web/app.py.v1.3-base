    settings = load_settings()
    user = get_user_by_id(session.get("user_id")) if session.get("user_id") else None
    theme = user.get("theme") if user and user.get("theme") else settings.get("theme", "dark")
    html = r'''
<!DOCTYPE html>
<html>
<head>
<script>
    const savedColors = {theme_colors};
    const root = document.documentElement;
    if (savedColors && Object.keys(savedColors).length > 0) {
        for (const [key, val] of Object.entries(savedColors)) {
            root.style.setProperty('--' + key, val);
        }
    }
</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>MediaGrabber v1.0</title>
<link rel="icon" type="image/svg+xml" href="/static/favicon.svg?v=1">
    <style>
        :root {
            --bg: #0f0f11;
            --card-bg: #1a1a20;
            --border: #2c2c36;
            --accent: #5b7cfa;
            --accent-hover: #6f8cff;
            --text: #eaeef2;
            --text-muted: #8899aa;
            --radius: 14px;
            --shadow: 0 8px 24px rgba(0,0,0,0.6);
            --transition: 0.25s ease;
            --sidebar-width: 200px;
        }
        body.light {
            --bg: #f5f7fc;
            --card-bg: #ffffff;
            --border: #d0d7e6;
            --text: #1e2230;
            --text-muted: #4a5268;
            --shadow: 0 8px 24px rgba(0,0,0,0.08);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background: var(--bg);
            color: var(--text);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            padding: 0;
            min-height: 100vh;
            transition: background var(--transition), color var(--transition);
            display: flex;
        }
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar);
            border-right: 1px solid var(--border);
            height: 100vh;
            position: sticky;
            top: 0;
            padding: 20px 0;
            display: flex;
            flex-direction: column;
            transition: background var(--transition), border var(--transition);
            flex-shrink: 0;
        }
        .sidebar button {
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 10px 20px;
            text-align: left;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all var(--transition);
            border-left: 3px solid transparent;
            width: 100%;
        }
        .sidebar button:hover { background: var(--border); color: var(--text); }
        .sidebar button.active {
            color: var(--accent);
            border-left-color: var(--accent);
            background: var(--border);
        }

        .user-widget { transition: background 0.2s; }
        .user-widget:hover { background: var(--border); }
        .sidebar .version {
            margin-top: auto;
            padding: 20px;
            font-size: 0.8rem;
            color: var(--text-muted);
            border-top: 1px solid var(--border);
        }
        .main {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            max-height: 100vh;
        }
        .top-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 24px;
        }
        .top-header h1 {
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(135deg, #a0b4ff, #5b7cfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .top-header .subtitle {
            color: var(--text-muted);
            font-size: 0.9rem;
        }
        .view { display: none; }
        .view.active { display: block; }
        .form-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 28px;
        }
        .form-row input {
            flex: 1;
            min-width: 200px;
            padding: 14px 18px;
            font-size: 1rem;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            color: var(--text);
            outline: none;
            transition: border-color var(--transition), background var(--transition), color var(--transition);
        }
        .form-row input:focus { border-color: var(--accent); }
        .form-row input::placeholder { color: var(--text-muted); }
        .form-row button {
            padding: 14px 28px;
            font-size: 1rem;
            font-weight: 600;
            background: var(--accent);
            border: none;
            border-radius: var(--radius);
            color: #fff;
            cursor: pointer;
            transition: background var(--transition), transform 0.1s;
            white-space: nowrap;
        }
        .form-row button:hover { background: var(--accent-hover); }
        .form-row button:active { transform: scale(0.96); }
        .form-row button:disabled { opacity: 0.7; cursor: default; }
        .mode-selector {
            display: none;
            margin: 8px 0;
            padding: 8px 12px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 8px;
        }
        .mode-selector label {
            margin-right: 16px;
            font-size: 0.95rem;
            cursor: pointer;
        }
        .mode-selector input[type="radio"] {
            margin-right: 4px;
            transform: scale(1.1);
        }
        .mode-selector .hint {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-left: 12px;
        }
        .queue-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 8px;
            flex-wrap: wrap;
            gap: 8px;
        }
        .queue-title span {
            font-size: 1.2rem;
            font-weight: 500;
            color: var(--text-muted);
        }
        .clear-btn {
            background: #3a1a1a;
            color: #cf6f6f;
            border: none;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: background var(--transition);
        }
        .clear-btn:hover { background: #5a2a2a; }
        body.light .clear-btn { background: #f8d7da; color: #721c24; }
        body.light .clear-btn:hover { background: #f5c6cb; }
        .card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px;
            margin-bottom: 16px;
            box-shadow: var(--shadow);
            transition: background var(--transition), border var(--transition), box-shadow var(--transition);
        }
        .card:hover { border-color: #3a3a4a; }
        body.light .card:hover { border-color: #b0bcd6; }
        .card-top {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            flex-wrap: wrap;
        }
        .card-thumb {
            flex: 0 0 120px;
            min-height: 80px;
            border-radius: 10px;
            overflow: hidden;
            background: #222;
            border: 1px solid var(--border);
            transition: border var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        body.light .card-thumb { background: #eef2f8; }
        .card-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .thumb-yt img { aspect-ratio: 16/9; }
        .thumb-spotify img { aspect-ratio: 1/1; }
        .thumb-gallery img {
            aspect-ratio: 9/16;
            object-fit: contain;
            background: #111;
        }
        .card-info {
            flex: 1;
            min-width: 160px;
        }
        .card-status {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 2px 10px;
            border-radius: 20px;
            background: #2a2a34;
            color: var(--text-muted);
            margin-bottom: 4px;
        }
        .card-status.done { background: #1a3a2a; color: #6fcf97; }
        .card-status.running { background: #1a2a3a; color: #6fa8cf; }
        .card-status.failed { background: #3a1a1a; color: #cf6f6f; }
        .card-status.queued { background: #2a2a20; color: #c4c46f; }
        .card-status.cancelled { background: #3a3a3a; color: #8899aa; }
        body.light .card-status.done { background: #d4edda; color: #155724; }
        body.light .card-status.running { background: #cce5ff; color: #004085; }
        body.light .card-status.failed { background: #f8d7da; color: #721c24; }
        body.light .card-status.queued { background: #fff3cd; color: #856404; }
        body.light .card-status.cancelled { background: #e9ecef; color: #495057; }
        .engine-badge {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 12px;
            background: #2a2a34;
            color: #8899aa;
            margin-left: 6px;
        }
        body.light .engine-badge { background: #e9ecef; color: #495057; }
        .card-url {
            font-size: 0.9rem;
            word-break: break-all;
            color: var(--text-muted);
            margin: 4px 0 6px;
        }
        .card-meta {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px 20px;
            font-size: 0.8rem;
            color: var(--text-muted);
        }
        .card-meta .jobid {
            font-family: monospace;
            background: #0a0a0e;
            padding: 0 8px;
            border-radius: 4px;
            color: #8899bb;
        }
        body.light .card-meta .jobid {
            background: #eef2f8;
            color: #3a4a6a;
        }
        .action-btn {
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 2px 10px;
            font-size: 0.75rem;
            cursor: pointer;
            color: var(--text-muted);
            transition: all var(--transition);
            text-decoration: none;
            display: inline-block;
            margin: 0 4px 4px 0;
        }
        .action-btn:hover { background: var(--border); color: var(--text); }
        .action-btn.danger:hover { background: #3a1a1a; color: #cf6f6f; border-color: #cf6f6f; }
        body.light .action-btn.danger:hover { background: #f8d7da; color: #721c24; border-color: #721c24; }
        .action-btn.retry { border-color: #f0ad4e; color: #f0ad4e; }
        .action-btn.retry:hover { background: #f0ad4e; color: #1a1a20; }
        .action-btn.archive { border-color: #dc3545; color: #dc3545; }
        .action-btn.archive:hover { background: #dc3545; color: #fff; }
        .progress-wrap {
            margin: 12px 0 8px;
        }
        .progress-bar {
            height: 6px;
            background: #2a2a34;
            border-radius: 10px;
            overflow: hidden;
        }
        body.light .progress-bar { background: #dde3ed; }
        .progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #5b7cfa, #a0b4ff);
            border-radius: 10px;
            transition: width 0.3s ease;
        }
        .progress-label {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-bottom: 2px;
        }
        .file-path {
            font-size: 0.8rem;
            color: #6fcf97;
            background: #0f1f1a;
            padding: 4px 10px;
            border-radius: 6px;
            border: 1px solid #1a3a2a;
            display: inline-block;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            margin: 4px 0 8px;
        }
        body.light .file-path {
            background: #e6f4ea;
            color: #155724;
            border-color: #b8dfc6;
        }
        .empty {
            text-align: center;
            color: var(--text-muted);
            padding: 40px 0;
            font-size: 0.95rem;
        }
        .settings-group {
            margin-bottom: 24px;
        }
        .settings-group h3 {
            color: var(--text-muted);
            margin-bottom: 12px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 6px;
        }
        .settings-group label {
            display: block;
            margin: 12px 0 4px;
            font-weight: 500;
        }
        .settings-group select, .settings-group input[type="text"], .settings-group input[type="number"] {
            width: 100%;
            padding: 10px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text);
            font-size: 1rem;
        }
        .settings-group select option { background: var(--card-bg); }
        .settings-group input[type="checkbox"] {
            transform: scale(1.3);
            margin-right: 8px;
        }
        .checkbox-group {
            display: flex;
            align-items: center;
            margin-top: 8px;
        }
        .checkbox-group label {
            display: inline;
            margin: 0;
        }
        .hint {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 4px;
        }
        .settings-actions {
            margin-top: 20px;
        }
        .settings-actions button {
            padding: 12px 24px;
            background: var(--accent);
            border: none;
            border-radius: 8px;
            color: #fff;
            font-weight: 600;
            cursor: pointer;
        }
        .settings-actions button:hover { background: var(--accent-hover); }
        .theme-toggle-btn {
            padding: 6px 14px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            color: var(--text);
            cursor: pointer;
            font-size: 1rem;
        }
        .theme-toggle-btn:hover { background: var(--border); }

        /* Utilities styles */
        .utility-section {
            margin-bottom: 24px;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 12px 16px;
        }
        .utility-section summary {
            font-weight: 600;
            font-size: 1.1rem;
            cursor: pointer;
            color: var(--text);
            padding: 4px 0;
        }
        .utility-section summary:hover {
            color: var(--accent);
        }
        .utility-section .content {
            margin-top: 12px;
        }
        .utility-section button {
            padding: 8px 16px;
            background: var(--accent);
            border: none;
            border-radius: 6px;
            color: #fff;
            cursor: pointer;
            margin-right: 8px;
        }
        .utility-section button:disabled {
            opacity: 0.6;
            cursor: default;
        }
        .utility-section input[type="text"] {
            width: 100%;
            padding: 8px;
            margin: 8px 0;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text);
        }
        .utility-log {
            background: #0a0a0e;
            padding: 16px;
            border-radius: 8px;
            max-height: 400px;
            overflow-y: auto;
            font-family: monospace;
            font-size: 0.8rem;
            white-space: pre-wrap;
            word-break: break-word;
            color: #b0c0d0;
            border: 1px solid var(--border);
            margin-top: 12px;
        }
        body.light .utility-log {
            background: #f0f2f6;
            color: #1e2230;
        }
        .utility-status {
            margin-bottom: 12px;
            font-weight: 500;
        }
        .utility-status.running { color: #6fa8cf; }
        .utility-status.done { color: #6fcf97; }
        .utility-status.failed { color: #cf6f6f; }

        /* Metadata list mobile fix */
        .metadata-list {
            max-height: 400px;
            overflow-y: auto;
            margin-top: 10px;
        }
        .metadata-item {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 10px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            word-break: break-word;
        }
        .metadata-item .title {
            font-weight: 600;
            word-break: break-word;
        }
        .metadata-item .uploader {
            color: var(--text-muted);
            font-size: 0.85rem;
            word-break: break-word;
        }
        .metadata-item .actions {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
        }
        .metadata-item .actions button {
            padding: 4px 10px;
            font-size: 0.75rem;
        }

        /* Archive manager */
        .archive-entry {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 0;
            border-bottom: 1px solid var(--border);
            flex-wrap: wrap;
            gap: 8px;
        }
        .archive-entry:last-child { border-bottom: none; }
        .archive-entry .entry-text {
            font-family: monospace;
            font-size: 0.85rem;
            word-break: break-all;
            flex: 1;
        }
        .archive-entry .delete-btn {
            background: #dc3545;
            color: #fff;
            border: none;
            border-radius: 4px;
            padding: 2px 8px;
            cursor: pointer;
            flex-shrink: 0;
        }
        .archive-entry .delete-btn:hover { background: #c82333; }

        /* Metadata Editor */
        .file-item {
            padding: 6px 8px;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .file-item:hover { background: var(--border); }
        .file-item .file-name { flex: 1; }
        .file-item .file-cover { width: 40px; height: 40px; object-fit: cover; border-radius: 4px; background: #222; }
        .file-item .file-tags { font-size: 0.8rem; color: var(--text-muted); }
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        .modal.active {
            display: flex;
        }
        .modal-content {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 24px;
            max-width: 600px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
        }
        .modal-content h3 {
            margin-bottom: 16px;
        }
        .modal-content label {
            display: block;
            margin-top: 12px;
            font-weight: 500;
        }
        .modal-content input, .modal-content textarea {
            width: 100%;
            padding: 8px;
            margin-top: 4px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text);
        }
        .modal-content textarea {
            min-height: 60px;
            resize: vertical;
        }
        .modal-content input[type="file"] {
            padding: 6px;
            background: transparent;
            border: none;
        }
        .modal-actions {
            margin-top: 16px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .modal-actions button {
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
        .modal-actions .save-btn { background: var(--accent); color: #fff; }
        .modal-actions .cancel-btn { background: var(--border); color: var(--text); }
        .modal-actions .cover-preview { max-width: 100px; max-height: 100px; }

        @media (max-width: 768px) {
            body { flex-direction: column; }
            
            /* Fix for User Profile on mobile */
            .user-widget {
                width: 100% !important;
                margin-bottom: 12px;
                padding: 12px !important;
                border: 1px solid var(--border) !important;
                border-radius: 8px;
                background: var(--card-bg);
            }
            
            .sidebar {
                gap: 8px;
                width: 100%;
                height: auto;
                position: static;
                border-right: none;
                border-bottom: 1px solid var(--border);
                flex-direction: row;
                flex-wrap: wrap;
                padding: 10px;
            }
            .sidebar button { flex: 1; min-width: 80px; text-align: center; border-left: none; border-bottom: 3px solid transparent; padding: 8px 12px; }
            .sidebar button.active { border-bottom-color: var(--accent); border-left-color: transparent; }
            .sidebar .version { display: none; }
            .main { padding: 12px; max-height: none; }
            .top-header h1 { font-size: 1.4rem; }
            .metadata-item { flex-direction: column; align-items: stretch; }
            .metadata-item .actions { justify-content: flex-start; }
        }
    
        .role-user .admin-only-utility,
        .role-user .admin-only-settings {
            display: none !important;
        }

    /* =========================================
       MODERN UI REFRESH - V1.0
       ========================================= */
    
    /* 1. Glassmorphism Header & Sidebar */
    .sidebar {
        background: rgba(0,0,0,0.2) !important;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-right: 1px solid var(--border);
    }
    .top-header {
        background: rgba(0,0,0,0.1) !important;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
        padding: 15px 24px !important;
        margin-bottom: 20px;
        border-radius: 12px;
    }

    /* 2. Rounded, Soft Cards */
    .card, .utility-section, details, .job-card {
        border-radius: 16px !important;
        border: 1px solid var(--border) !important;
        box-shadow: 0 8px 32px rgba(0,0,0,0.2) !important;
        background: var(--card) !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    
    .card:hover, .job-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 48px rgba(0,0,0,0.3) !important;
        border-color: var(--accent) !important;
    }

    /* 3. Modern Inputs */
    input[type="text"], input[type="url"], input[type="password"], select, textarea {
        border-radius: 12px !important;
        border: 2px solid var(--border) !important;
        background: rgba(0,0,0,0.2) !important;
        transition: all 0.2s ease;
        padding: 12px 16px !important;
    }
    input[type="text"]:focus, input[type="url"]:focus, input[type="password"]:focus, select:focus, textarea:focus {
        border-color: var(--accent) !important;
        box-shadow: 0 0 0 3px rgba(91, 124, 250, 0.25) !important;
        outline: none;
    }

    /* 4. Glowing Buttons */
    button, .btn {
        border-radius: 10px !important;
        font-weight: 600;
        transition: all 0.2s ease;
        cursor: pointer;
    }
    button:hover {
        transform: translateY(-1px);
        filter: brightness(1.1);
        box-shadow: 0 4px 12px rgba(91, 124, 250, 0.3);
    }
    button:active {
        transform: translateY(1px);
    }

    /* 5. Sidebar Navigation Links */
    .sidebar button {
        border-radius: 10px;
        margin: 4px 12px;
        padding: 12px 16px;
        text-align: left;
        transition: all 0.2s ease;
        background: transparent;
        color: var(--text);
    }
    .sidebar button:hover {
        background: rgba(255,255,255,0.05);
    }
    .sidebar button.active {
        background: var(--accent) !important;
        color: white !important;
        box-shadow: 0 4px 15px rgba(91, 124, 250, 0.4);
    }

    /* 6. Smooth Scrollbar */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--accent); }

    /* 7. Animations */
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .view { animation: fadeIn 0.3s ease-out; }
    .card { animation: fadeIn 0.3s ease-out; }

</style>
</head>
<body class="{theme} {role_class}">
<div class="sidebar">
    <div class="user-widget" id="userWidget" style="padding: 16px; border-bottom: 1px solid var(--border); margin-bottom: 10px; cursor: pointer;" onclick="openAccountModal()">
        <div style="display:flex; align-items:center; gap:12px;">
            <img id="userAvatarDisplay" src="" style="width:40px; height:40px; border-radius:50%; object-fit:cover; background:var(--border); border:2px solid var(--accent);">
            <div style="flex:1; overflow:hidden;">
                <div id="userDisplayName" style="font-weight:600; font-size:0.95rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Loading...</div>
                <div id="userRoleBadge" style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase;">Role</div>
            </div>
        </div>
    </div>
    
    <button onclick="openThemeModal()" style="width: calc(100% - 32px); margin: 0 16px 10px 16px; padding: 8px; border-radius: 8px; background: rgba(255,255,255,0.05); border: 1px solid var(--border); color: var(--text); font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.2s;">
        🎨 Customize Theme
    </button>
    
    <button class="active" data-view="queue">📋 Queue</button>
    <button data-view="settings">⚙️ Settings</button>
    <button data-view="utilities">🔧 Utilities</button>
    <div class="version">v1.0</div>

</div>
<div class="main">
    <div class="top-header">
        <div style="display:flex; align-items:center; gap:10px;">
            <img id="appLogo" src="/static/custom_logo.png" onerror="this.style.display='none'" style="height:32px; display:none; object-fit:contain;">
            <h1 style="margin:0;">📡 MediaGrabber</h1>
        </div>
        <span class="subtitle">v1.0</span>
    </div>
    <!-- Queue -->
    <div id="view-queue" class="view active">
        <div class="form-row">
            <input id="url" type="url" placeholder="Paste URL (YouTube, Spotify, etc.)" autofocus>
            <button onclick="grab()">Grab</button>
        </div>
        <div class="mode-selector" id="modeSelector">
            <label><input type="radio" name="mode" value="video" checked> Video</label>
            <label><input type="radio" name="mode" value="audio"> Audio (MP3)</label>
            <span class="hint">For YouTube Music, choose Audio</span>
        </div>
        <div class="queue-title">
            <span>Queue</span>
            <button class="clear-btn" onclick="clearCompleted()">🗑️ Clear Completed</button>
        </div>
        <div id="queue"><div class="empty">No jobs yet</div></div>
    </div>
    <!-- Settings -->
    <div id="view-settings" class="view">
        <h2>⚙️ Settings</h2>
        <form id="settingsForm">

            <div class="settings-group">
                <h3>Video / Audio</h3>
                <label for="video_res">Max Video Resolution</label>
                <select id="video_res" name="video_res">
                    <option value="2160">4K (2160p)</option>
                    <option value="1440">1440p</option>
                    <option value="1080" selected>1080p</option>
                    <option value="720">720p</option>
                    <option value="480">480p</option>
                    <option value="360">360p</option>
                </select>
                <label for="container">Container Format</label>
                <select id="container" name="container">
                    <option value="mp4" selected>MP4</option>
                    <option value="webm">WebM</option>
                    <option value="mkv">MKV</option>
                </select>
                <label for="audio_format">Audio Format</label>
                <select id="audio_format" name="audio_format">
                    <option value="mp3" selected>MP3</option>
                    <option value="flac">FLAC</option>
                </select>
                <label for="audio_bitrate">Audio Bitrate (MP3)</label>
                <select id="audio_bitrate" name="audio_bitrate">
                    <option value="320k" selected>320 kbps</option>
                    <option value="192k">192 kbps</option>
                    <option value="128k">128 kbps</option>
                </select>
                <div class="checkbox-group">
                    <input type="checkbox" id="generate_lrc" name="generate_lrc">
                    <label for="generate_lrc">Generate LRC files (Spotify)</label>
                </div>
            </div>
            <div class="admin-only-settings" style="{admin_style}">
            <div class="settings-group">
                <h3>Folder Structure</h3>
                <label for="folder_structure">Template</label>
                <select id="folder_structure" name="folder_structure">
                    <option value="default" selected>Default (YouTube: Uploader/Year, Spotify: Artist/Album)</option>
                    <option value="flat">Flat (all in root)</option>
                </select>
                <div class="hint">More options coming soon.</div>
            </div>
            <div class="settings-group">
                <h3>📂 Storage Paths</h3>
                <label for="yt_base_path">YouTube Base Path</label>
                <input type="text" id="yt_base_path" name="yt_base_path" placeholder="/media/YouTube">
                <div class="hint">Where YouTube videos will be stored (Uploader/Year/ inside)</div>
                <label for="music_base_path">Music Base Path</label>
                <input type="text" id="music_base_path" name="music_base_path" placeholder="/opt/navidrome/music/navidrome/music">
                <div class="hint">Where Spotify downloads will be stored (Artist/Album/ inside)</div>
                <label for="gallery_base_path">Gallery Base Path</label>
                <input type="text" id="gallery_base_path" name="gallery_base_path" placeholder="/media/Gallery">
                <div class="hint">Where gallery‑dl downloads (Instagram, TikTok, etc.) will be stored</div>
            </div>
            <div class="settings-group">
                <h3>🍪 Cookie Files</h3>
                <label for="cookies_youtube_path">YouTube Cookies File</label>
                <input type="text" id="cookies_youtube_path" name="cookies_youtube_path" placeholder="/path/to/youtube_cookies.txt">
                <div class="hint">Path to a cookies.txt file for YouTube (or use Firefox cookies via --cookies-from-browser in extra args)</div>
                <label for="cookies_gallery_path">Gallery Cookies File</label>
                <input type="text" id="cookies_gallery_path" name="cookies_gallery_path" placeholder="/path/to/gallery_cookies.txt">
                <div class="hint">For Instagram, TikTok, etc. (used by gallery-dl)</div>
            </div>
            <div class="settings-group">
                <h3>Media Servers</h3>
                <label for="jellyfin_url">Jellyfin URL</label>
                <input type="text" id="jellyfin_url" name="jellyfin_url" placeholder="http://localhost:8096">
                <label for="jellyfin_api_key">Jellyfin API Key</label>
                <input type="text" id="jellyfin_api_key" name="jellyfin_api_key" placeholder="(optional)">
                <label for="navidrome_url">Navidrome URL</label>
                <input type="text" id="navidrome_url" name="navidrome_url" placeholder="http://localhost:4533">
                <label for="navidrome_api_key">Navidrome API Key</label>
                <input type="text" id="navidrome_api_key" name="navidrome_api_key" placeholder="(optional)">
                <label for="plex_url">Plex URL</label>
                <input type="text" id="plex_url" name="plex_url" placeholder="http://localhost:32400">
                <label for="plex_token">Plex Token</label>
                <input type="text" id="plex_token" name="plex_token" placeholder="Your Plex token">
                <label for="plex_section_id">Plex Library Section ID</label>
                <input type="text" id="plex_section_id" name="plex_section_id" placeholder="e.g., 1">
                <div class="hint">Find the section ID from Plex Web → Settings → Manage → Libraries → hover the library, the URL shows ?sectionId=...</div>
            </div>

            <div class="settings-group">
                
                <h3>🖼️ App Logo</h3>
                <div style="margin-bottom:15px;">
                    <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:10px;">Upload a PNG to replace the emoji logo (recommended size: 128x128).</p>
                    <input type="file" id="logoUpload" accept="image/png" style="margin-bottom:10px; font-size:0.85rem;">
                    <button onclick="uploadLogo()" class="btn">Upload Logo</button>
                </div>
                <script>
                function uploadLogo() {
                    const file = document.getElementById('logoUpload').files[0];
                    if (!file) return alert('Select a file first');
                    const fd = new FormData();
                    fd.append('logo', file);
                    fetch('/api/upload-logo', { method: 'POST', body: fd })
                    .then(r => r.json())
                    .then(d => {
                        if(d.success) { alert('Logo uploaded!'); location.reload(); }
                        else alert('Error: ' + d.error);
                    });
                }
                </script>

<h3>✉️ Email (SMTP) Settings</h3>
                <div class="hint" style="margin-bottom:10px;">Required for Password Reset emails to work.</div>
                <label for="smtp_host">SMTP Host</label>
                <input type="text" id="smtp_host" name="smtp_host" placeholder="smtp.gmail.com">
                <label for="smtp_port">SMTP Port</label>
                <input type="text" id="smtp_port" name="smtp_port" placeholder="587">
                <label for="smtp_user">SMTP Username</label>
                <input type="text" id="smtp_user" name="smtp_user" placeholder="your@email.com">
                <label for="smtp_pass">SMTP Password / App Password</label>
                <input type="password" id="smtp_pass" name="smtp_pass" placeholder="••••••••">
                <label for="smtp_from">From Address</label>
                <input type="text" id="smtp_from" name="smtp_from" placeholder="MediaGrabber <noreply@yourdomain.com>">
            </div>
            <div class="settings-group">
                <h3>Extra Arguments</h3>
                <label for="ytdlp_extra">yt‑dlp extra args</label>
                <input type="text" id="ytdlp_extra" name="ytdlp_extra" placeholder="--no-check-certificate">
                <label for="spotdl_extra">spotdl extra args</label>
                <input type="text" id="spotdl_extra" name="spotdl_extra" placeholder="--no-cache">
                <label for="gallerydl_extra">gallery‑dl extra args</label>
                <input type="text" id="gallerydl_extra" name="gallerydl_extra" placeholder="--retries 5">
            </div>
            </div>
            <div class="settings-actions">
                <button type="submit">Save Settings</button>
                <span id="settingsStatus" style="margin-left:16px;color:#6fcf97;"></span>
            </div>
        </form>
    </div>
    <!-- Utilities -->
    <div id="view-utilities" class="view">
        <h2>🔧 Utilities</h2>

        <details class="utility-section admin-only-utility">
            <summary>🔄 Reorganize Files</summary>
            <div class="content">
                <p>Scan configured paths and move files to proper folders (YouTube: Uploader/Year, Music: Artist/Album, Gallery: Extractor/Uploader).</p>
                <button id="reorgBtn" onclick="startReorganize()">🚀 Start Reorganize</button>
                <div class="utility-status" id="reorgStatus">Idle</div>
                <div class="utility-log" id="reorgLog">Waiting to start...</div>
            </div>
        </details>

        <details class="utility-section admin-only-utility">
            <summary>🗑️ Deduplicate Files</summary>
            <div class="content">
                <p>Find and remove exact duplicate files (SHA‑256) from a folder. Keeps the largest copy, moves duplicates to /media/duplicates_trash/.</p>
                <label for="dedupTarget">Target folder:</label>
                <input type="text" id="dedupTarget" placeholder="/media/YouTube" value="/media/YouTube">
                <div>
                    <button id="dedupScanBtn" onclick="startDedup('scan')">🔍 Scan Duplicates</button>
                    <button id="dedupDeleteBtn" onclick="startDedup('delete')">🗑️ Delete Duplicates</button>
                </div>
                <div class="utility-status" id="dedupStatus">Idle</div>
                <div class="utility-log" id="dedupLog">Ready to scan...</div>
            </div>
        </details>

        <details class="utility-section admin-only-utility">
            <summary>📝 Metadata Updater</summary>
            <div class="content">
                <p>Scan a folder, edit metadata (title, description, uploader, date, tags) for any video file.</p>
                <label for="metadataPath">Folder to scan:</label>
                <input type="text" id="metadataPath" placeholder="/media/YouTube" value="/media/YouTube">
                <button onclick="scanMetadata()">🔍 Scan Metadata</button>
                <div id="metadataStatus" style="margin-top:8px; color:var(--text-muted);"></div>
                <div class="metadata-list" id="metadataList"></div>
            </div>
        </details>

        <details class="utility-section admin-only-utility">
            <summary>🗂️ Tmp Reorder</summary>
            <div class="content">
                <p>Move orphaned files from <code>/tmp/mediagrabber/</code> to their correct final directories (YouTube, Music, or Gallery).</p>
                <button id="tmpReorgBtn" onclick="startTmpReorg()">🚀 Reorder Tmp Files</button>
                <div class="utility-status" id="tmpReorgStatus">Idle</div>
                <div class="utility-log" id="tmpReorgLog">Waiting to start...</div>
            </div>
        </details>

        <details class="utility-section admin-only-utility">
            <summary>📋 Archive Manager</summary>
            <div class="content">
                <p>View and delete entries from the download archive (<code>~/.mediagrabber/archive.txt</code>).</p>
                <button onclick="loadArchive()">🔄 Refresh Archive List</button>
                <div id="archiveList" style="margin-top:12px;">
                    <p>Click "Refresh" to load archive entries.</p>
                </div>
            </div>
        </details>

        <details class="utility-section admin-only-utility" id="metadataEditorDetails">
            <summary>🖼️ Metadata Editor</summary>
            <div class="content">
                <p>Browse a folder, click a file to edit its metadata (title, artist, album, date, description) and upload a new cover image.</p>
                <label for="editorPath">Folder to scan:</label>
                <input type="text" id="editorPath" placeholder="/media/YouTube or /opt/navidrome/music/navidrome/music" value="/media/YouTube">
                <button onclick="scanEditorFiles()">🔍 Scan Files</button>
                <div id="editorStatus" style="margin-top:8px; color:var(--text-muted);"></div>
                <div id="fileList" style="margin-top:10px; max-height:400px; overflow-y:auto;"></div>
            </div>
        </details>


        <!-- Manage Users -->
        <details class="utility-section admin-only-utility" id="manageUsersDetails">
            <summary>👥 Manage Users</summary>
            <div class="content">
                <p>Add or remove user accounts. Admin accounts have full access to settings and utilities.</p>
                
                <div id="userList" style="margin-bottom:20px; border:1px solid var(--border); border-radius:6px; padding:10px; overflow-x:auto;">
                    Loading users...
                </div>

                <h4 style="margin-bottom:10px;">Add New User</h4>
                <div style="display:flex; gap:10px; flex-wrap:wrap;">
                    <input type="text" id="newUsername" placeholder="Username" style="flex:1; min-width:150px; padding:8px; background:var(--card-bg); border:1px solid var(--border); border-radius:6px; color:var(--text);">
                    <input type="password" id="newPassword" placeholder="Password (min 8 chars)" style="flex:1; min-width:150px; padding:8px; background:var(--card-bg); border:1px solid var(--border); border-radius:6px; color:var(--text);">
                    <select id="newRole" style="padding:8px; background:var(--card-bg); border:1px solid var(--border); border-radius:6px; color:var(--text);">
                        <option value="user">Standard User</option>
                        <option value="admin">Administrator</option>
                    </select>
                    <button onclick="addUser()" style="background:var(--accent); color:#fff; border:none; border-radius:6px; padding:8px 16px; cursor:pointer;">➕ Add User</button>
                </div>
            </div>
        </details>

        <!-- Radio Manager -->
        <details class="utility-section">
            <summary>📻 Radio Manager</summary>
            <div class="content">
                <p>Search and add internet radio stations to your Navidrome server using the <a href="https://www.radio-browser.info/" target="_blank">Radio-Browser</a> API.</p>
                
                <!-- Database path -->
                <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; align-items:center;">
                    <label style="font-weight:500;">📁 Database Path:</label>
                    <input type="text" id="radioDbPath" placeholder="/var/lib/navidrome/navidrome.db" value="/var/lib/navidrome/navidrome.db" style="flex:2; min-width:200px; padding:8px; background:var(--card-bg); border:1px solid var(--border); border-radius:6px; color:var(--text);">
                    <button onclick="setRadioDb()">💾 Save Path</button>
                    <button onclick="checkRadioStatus()">🔄 Check Status</button>
                    <span id="radioStatusMsg" style="font-size:0.9rem; color:var(--text-muted);"></span>
                </div>
                
                <!-- Search -->
                <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px;">
                    <input type="text" id="radioSearchInput" placeholder="Search by name, genre, or country..." style="flex:2; min-width:200px; padding:8px; background:var(--card-bg); border:1px solid var(--border); border-radius:6px; color:var(--text);">
                    <select id="radioSearchType" style="padding:8px; background:var(--card-bg); border:1px solid var(--border); border-radius:6px; color:var(--text);">
                        <option value="name">Name</option>
                        <option value="genre">Genre</option>
                        <option value="country">Country</option>
                    </select>
                    <button onclick="searchRadios()">🔍 Search</button>
                    <button onclick="listRadios()">📋 List Added</button>
                </div>
                
                <!-- Results -->
                <div id="radioResults" style="max-height:400px; overflow-y:auto; margin-top:8px;"></div>
                
                <!-- Manual add -->
                <div style="margin-top:12px; padding-top:12px; border-top:1px solid var(--border);">
                    <h4>➕ Add Radio Manually</h4>
                    <div style="display:flex; gap:8px; flex-wrap:wrap;">
                        <input type="text" id="radioUrlInput" placeholder="Stream URL (e.g., http://example.com:8000/stream.mp3)" style="flex:2; min-width:200px; padding:8px; background:var(--card-bg); border:1px solid var(--border); border-radius:6px; color:var(--text);">
                        <input type="text" id="radioNameInput" placeholder="Station name (optional)" style="flex:1; min-width:150px; padding:8px; background:var(--card-bg); border:1px solid var(--border); border-radius:6px; color:var(--text);">
                        <button onclick="addRadioManually()">➕ Add</button>
                    </div>
                </div>
            </div>
        </details>
    </div>
</div>


<div class="modal" id="accountModal">
    <div class="modal-content">
        <h3>👤 My Account</h3>
        <form id="accountForm" enctype="multipart/form-data">
            <!-- Tabs -->
            <div style="display: flex; gap: 10px; border-bottom: 1px solid var(--border); margin-bottom: 20px;">
                <button type="button" class="tab-btn" onclick="switchAccountTab('profile', this)" style="background:transparent; border:none; color:var(--accent); border-bottom:2px solid var(--accent); font-weight:bold; cursor:pointer; padding:10px; font-size:1rem; margin-bottom:-1px;">Profile</button>
                <button type="button" class="tab-btn" onclick="switchAccountTab('security', this)" style="background:transparent; border:none; color:var(--text-muted); font-weight:bold; cursor:pointer; padding:10px; font-size:1rem;">Security</button>
                
            </div>

            <!-- Tab 1: Profile -->
            <div id="tab-profile" class="account-tab-content">
                <label>Profile Picture</label>
                <div style="display:flex; align-items:center; gap:16px; margin-bottom:12px;">
                    <img id="modalAvatarPreview" src="" style="width:64px; height:64px; border-radius:50%; object-fit:cover; background:var(--border);">
                    <input type="file" id="accountAvatarFile" name="avatar" accept="image/*" style="width:auto;">
                </div>
                
                <label>Display Name</label>
                <input type="text" id="accountDisplayName" name="display_name">
                
                <label>Email (for password reset)</label>
                <input type="email" id="accountEmail" name="email" placeholder="you@example.com">
                
            </div>

            <!-- Tab 2: Security -->
            <div id="tab-security" class="account-tab-content" style="display:none;">

                <label>Change Password (leave blank to keep current)</label>
                <input type="password" id="accountPassword" name="new_password" placeholder="Min 8 characters">
                
                <hr style="border-color:var(--border); margin:20px 0;">
                
                <h4 style="margin-bottom:10px;">Two-Factor Authentication (2FA)</h4>
                <div id="2fa-disabled-view">
                    <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:10px;">Add an extra layer of security to your account.</p>
                    <button type="button" onclick="start2FASetup()" style="background:var(--accent); color:#fff; border:none; padding:10px; border-radius:6px; cursor:pointer; width:100%;">🔐 Enable 2FA</button>
                </div>
                
                <div id="2fa-setup-view" style="display:none; text-align:center;">
                    <p style="color:var(--accent); font-weight:600; margin-bottom:10px;">Scan this QR code with your Authenticator app</p>
                    <div id="2fa-qr-code" style="background:#fff; padding:10px; display:inline-block; border-radius:8px; margin-bottom:15px;"></div>
                    <input type="text" id="2fa-verify-code" placeholder="Enter 6-digit code" style="width:100%; padding:10px; background:var(--card-bg); border:1px solid var(--accent); border-radius:8px; color:var(--text); text-align:center; font-size:1.2rem; letter-spacing:2px;">
                    <button type="button" onclick="confirm2FA()" style="background:var(--accent); color:#fff; border:none; padding:10px; border-radius:6px; cursor:pointer; width:100%; margin-top:10px;">Verify & Enable</button>
                </div>

                <div id="2fa-enabled-view" style="display:none;">
                    <p style="color:#6fcf97; font-weight:600; margin-bottom:10px;">✅ 2FA is currently enabled.</p>
                    <button type="button" onclick="disable2FA()" style="background:#3a1a1a; color:#cf6f6f; border:none; padding:10px; border-radius:6px; cursor:pointer; width:100%;">Disable 2FA</button>
                </div>

                
                <div style="margin-top: 20px;">
                    <div style="position:relative; margin-top:20px;">
                    <button type="button" disabled style="background:transparent; border:1px solid var(--border); color:var(--text-muted); padding:10px; border-radius:6px; width:100%; opacity:0.5; cursor:not-allowed; filter:blur(1px);">🔑 Send Password Reset Email</button>
                    <div style="position:absolute; top:0; left:0; width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-weight:bold; color:var(--accent); text-shadow: 1px 1px 2px #000;">
                        Email Support Coming Soon
                    </div>
                </div>
                </div>
            </div>

            <!-- Tab 3: SMTP (Admin Only) -->
            

            <!-- Action Buttons -->
            <div class="modal-actions" style="margin-top:20px; border-top:1px solid var(--border); padding-top:20px;">
                <button class="save-btn" type="submit">💾 Save Changes</button>
                <button class="cancel-btn" type="button" onclick="closeAccountModal()">Cancel</button>
                <a href="/logout" style="text-decoration:none; padding:8px 16px; border-radius:6px; background:#3a1a1a; color:#cf6f6f; font-weight:600; margin-left:auto;">🚪 Logout</a>
            </div>
        </form>
    </div>
</div>
<!-- Metadata Editor Edit Modal -->
<div class="modal" id="editEditorModal">
    <div class="modal-content">
        <h3>✏️ Edit Metadata & Cover</h3>
        <form id="editorForm" enctype="multipart/form-data">
            <input type="hidden" id="editFilePath" name="file_path">
            <label>Title</label>
            <input type="text" id="editTitle" name="title" placeholder="Title">
            <label>Artist / Uploader</label>
            <input type="text" id="editArtist" name="artist" placeholder="Artist">
            <label>Album</label>
            <input type="text" id="editAlbum" name="album" placeholder="Album">
            <label>Date</label>
            <input type="text" id="editDate" name="date" placeholder="YYYYMMDD">
            <label>Description</label>
            <textarea id="editDescription" name="description" placeholder="Description"></textarea>
            <label>Cover Image</label>
            <input type="file" id="editCover" name="cover" accept="image/*">
            <div id="currentCoverPreview" style="margin-top:8px;"></div>
            <div class="modal-actions">
                <button class="save-btn" type="submit">💾 Save</button>
                <button class="cancel-btn" type="button" onclick="closeEditorModal()">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
    // ---------- Auth wrapper: redirect on 401 ----------
    (function () {
        const _fetch = window.fetch;
        window.fetch = function (url, opts) {
            return _fetch(url, opts).then(function (r) {
                if (r.status === 401) {
                    window.location.href = '/login?next=' + encodeURIComponent(location.pathname);
                    throw new Error('auth');
                }
                return r;
            });
        };
    })();

    // ---------- Theme ----------
    let currentTheme = '{theme}';
    function escapeHTML(str) {
        if (!str) return '';
        return String(str).replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag));
    }

    function setTheme(theme) {
        document.body.className = theme === 'light' ? 'light' : '';
        currentTheme = theme;
        const el = document.getElementById('currentTheme');
        if (el) el.textContent = theme;
        localStorage.setItem('mediagrabber-theme', theme);
        const fd = new FormData();
        fd.append('theme', theme);
        fetch('/api/me/update', { method: 'POST', body: fd }).catch(()=>{});
    }
    function toggleTheme() {
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        setTheme(newTheme);
    }
    const savedTheme = localStorage.getItem('mediagrabber-theme');
    if (savedTheme && savedTheme !== currentTheme) setTheme(savedTheme);

    // ---------- Show/hide mode selector ----------
    document.getElementById('url').addEventListener('input', function() {
        const url = this.value.trim();
        const isYoutube = url.includes('youtube.com') || url.includes('youtu.be');
        document.getElementById('modeSelector').style.display = isYoutube ? 'block' : 'none';
    });

    // ---------- View switching ----------
    document.querySelectorAll('.sidebar button[data-view]').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.sidebar button').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            const view = this.dataset.view;
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            document.getElementById('view-' + view).classList.add('active');
        });
    });

    // ---------- Queue functions ----------
    async function grab() {
        const url = document.getElementById('url').value.trim();
        if (!url) return;
        const mode = document.querySelector('input[name="mode"]:checked')?.value || 'video';
        const btn = document.querySelector('.form-row button');
        btn.textContent = '⏳';
        btn.disabled = true;
        await fetch('/grab', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'url=' + encodeURIComponent(url) + '&mode=' + mode
        });
        document.getElementById('url').value = '';
        btn.textContent = 'Grab';
        btn.disabled = false;
    }

    async function clearArchive(id) {
        if (!confirm('This will remove the URL from the archive and delete the job from the queue if it is completed. Proceed?')) return;
        const btn = document.querySelector(`.card[data-job-id="${id}"] .archive-btn`);
        if (btn) { btn.textContent = '⏳'; btn.disabled = true; }
        try {
            const res = await fetch('/clear-archive/' + id, { method: 'POST' });
            const data = await res.json();
            if (data.status === 'archive cleared' || data.status === 'archive cleared and job removed') {
                alert('Archive entry cleared');
            } else {
                alert('Error: ' + (data.error || 'unknown'));
            }
        } catch (e) {
            alert('Error: ' + e);
        }
        if (btn) { btn.disabled = false; btn.textContent = '🗑️ Archive'; }
    }

    async function retryJob(id) {
        if (!confirm('This will remove the existing entry from the archive and re-download the video. Proceed?')) return;
        const btn = document.querySelector(`.card[data-job-id="${id}"] .retry-btn`);
        if (btn) { btn.textContent = '⏳'; btn.disabled = true; }
        try {
            const res = await fetch('/retry/' + id, { method: 'POST' });
            const data = await res.json();
            if (data.status === 'retried') {
                alert('Retry started: ' + data.new_job_id);
            } else {
                alert('Retry failed: ' + (data.error || 'unknown error'));
            }
        } catch (e) {
            alert('Error: ' + e);
        }
        if (btn) { btn.disabled = false; btn.textContent = '🔄 Retry'; }
    }

    async function cancelJob(id) {
        if (!confirm('Cancel this job?')) return;
        await fetch('/cancel/' + id, { method: 'POST' });
    }
    async function removeJob(id) {
        if (!confirm('Remove this job from queue?')) return;
        await fetch('/remove/' + id, { method: 'DELETE' });
    }
    async function clearCompleted() {
        if (!confirm('Remove all completed (done/failed/cancelled) jobs?')) return;
        await fetch('/clear-completed', { method: 'POST' });
    }

    function renderQueue(data) {
        const q = document.getElementById('queue');
        const entries = Object.entries(data);
        if (!entries.length) {
            q.innerHTML = '<div class="empty">No jobs yet</div>';
            return;
        }
        let html = '';
        for (const [id, job] of entries) {
            const status = job.status || 'queued';
            const thumb = job.thumbnail ? `<img src="/media/${escapeHTML(job.thumbnail)}" alt="thumb">` : '';
            let engine = 'UNKNOWN';
            (job.log || []).forEach(line => {
                if (line.includes('Engine → SPOTIFY')) engine = 'SPOTIFY';
                else if (line.includes('Engine → GALLERY')) engine = 'GALLERY';
                else if (line.includes('Engine → YOUTUBE')) engine = 'YOUTUBE';
            });
            // YouTube Music tag
            if (engine === 'YOUTUBE' && job.url && job.url.includes('music.youtube.com')) {
                engine = 'YT MUSIC';
            }
            let thumbClass = '';
            if (engine === 'YOUTUBE') thumbClass = 'thumb-yt';
            else if (engine === 'SPOTIFY') thumbClass = 'thumb-spotify';
            else if (engine === 'GALLERY') thumbClass = 'thumb-gallery';
            let actions = '';
            if (status === 'running') {
                actions += `<button class="action-btn danger" onclick="cancelJob('${id}')">⏹ Cancel</button>`;
            } else if (status === 'queued') {
                actions += `<button class="action-btn danger" onclick="removeJob('${id}')">✕ Remove</button>`;
            } else {
                if (job.url) {
                    actions += `<button class="action-btn retry retry-btn" onclick="retryJob('${id}')">🔄 Retry</button>`;
                    actions += `<button class="action-btn archive archive-btn" onclick="clearArchive('${id}')">🗑️ Archive</button>`;
                }
                actions += `<button class="action-btn" onclick="removeJob('${id}')">✕ Remove</button>`;
            }
            const logBtn = `<a href="/log/${id}" class="action-btn">📋 Log</a>`;
            html += `
            <div class="card" data-job-id="${id}">
                <div class="card-top">
                    <div class="card-thumb ${thumbClass}">${thumb}</div>
                    <div class="card-info">
                        <div>
                            <span class="card-status ${status}">${status}</span>
                            <span class="engine-badge">${engine}</span>
                            <span style="float:right;">${logBtn} ${actions}</span>
                        </div>
                        <div class="card-url" style="display:flex; align-items:center; gap:8px;">
                            <span>${escapeHTML(job.url)}</span>
                            ${job.url ? `<button class="action-btn" onclick="copyToClipboard('${job.url}')" title="Copy URL" style="padding:2px 6px; font-size:0.75rem; background:var(--border); border:none; color:var(--text); cursor:pointer; border-radius:4px;">📋 Copy</button>` : ''}
                        </div>
                        <div class="card-meta">
                            <span class="jobid">${id.slice(0,8)}</span>
                            ${job.file ? '<span style="color:#6fcf97;">✓ done</span>' : ''}
                        </div>
                    </div>
                </div>
                <div class="progress-wrap">
                    <div class="progress-label"><span>Progress</span><span>${Math.round(job.progress || 0)}%</span></div>
                    <div class="progress-bar"><div class="progress-fill" style="width:${job.progress || 0}%"></div></div>
                </div>
                ${job.file ? `<div class="file-path">📁 ${escapeHTML(job.file)}</div>` : ''}
            </div>`;
        }
        q.innerHTML = html;
    }

    async function loadQueue() {
        try {
            const res = await fetch('/queue', { cache: 'no-store' });
            const data = await res.json();
            renderQueue(data);
        } catch (_) {}
    }

    // ---------- Reorganize ----------
    let reorgInterval = null;
    async function startReorganize() {
        const btn = document.getElementById('reorgBtn');
        btn.disabled = true;
        btn.textContent = '⏳ Starting...';
        const res = await fetch('/reorganize', { method: 'POST' });
        const data = await res.json();
        if (data.status === 'already running') {
            alert('Already running.');
            btn.disabled = false;
            btn.textContent = '🚀 Start Reorganize';
            return;
        }
        if (reorgInterval) clearInterval(reorgInterval);
        document.getElementById('reorgLog').textContent = 'Loading logs...';
        document.getElementById('reorgStatus').textContent = 'Running...';
        document.getElementById('reorgStatus').className = 'utility-status running';
        reorgInterval = setInterval(fetchReorgLogs, 1500);
        fetchReorgLogs();
        btn.textContent = '🔄 Running...';
    }

    async function fetchReorgLogs() {
        try {
            const res = await fetch('/reorganize-logs');
            const data = await res.json();
            const logDiv = document.getElementById('reorgLog');
            const statusDiv = document.getElementById('reorgStatus');
            logDiv.textContent = data.logs.join('\\n');
            if (!data.running) {
                statusDiv.textContent = '✅ Completed';
                statusDiv.className = 'utility-status done';
                if (reorgInterval) {
                    clearInterval(reorgInterval);
                    reorgInterval = null;
                    document.getElementById('reorgBtn').disabled = false;
                    document.getElementById('reorgBtn').textContent = '🚀 Start Reorganize';
                }
            } else {
                statusDiv.textContent = '🔄 Running...';
                statusDiv.className = 'utility-status running';
                document.getElementById('reorgBtn').disabled = true;
                document.getElementById('reorgBtn').textContent = '🔄 Running...';
            }
            logDiv.scrollTop = logDiv.scrollHeight;
        } catch (_) {}
    }

    // ---------- Deduplicate ----------
    async function startDedup(action) {
        const target = document.getElementById('dedupTarget').value.trim();
        if (!target) { alert('Please enter a target folder.'); return; }
        const scanBtn = document.getElementById('dedupScanBtn');
        const delBtn = document.getElementById('dedupDeleteBtn');
        const logDiv = document.getElementById('dedupLog');
        const statusDiv = document.getElementById('dedupStatus');
        scanBtn.disabled = true;
        delBtn.disabled = true;
        logDiv.textContent = 'Running...';
        statusDiv.textContent = 'Running...';
        statusDiv.className = 'utility-status running';

        try {
            const response = await fetch('/deduplicate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ target: target, action: action })
            });
            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let result = '';
            while (true) {
                const { done, value } = await reader.read();
                if (done) break;
                const chunk = decoder.decode(value);
                result += chunk;
                logDiv.textContent = result;
                logDiv.scrollTop = logDiv.scrollHeight;
            }
            statusDiv.textContent = '✅ Completed';
            statusDiv.className = 'utility-status done';
        } catch (e) {
            logDiv.textContent = 'Error: ' + e;
            statusDiv.textContent = '❌ Error';
            statusDiv.className = 'utility-status failed';
        }
        scanBtn.disabled = false;
        delBtn.disabled = false;
    }

    // ---------- Metadata Updater ----------
    let currentMetadata = [];

    async function scanMetadata() {
        const path = document.getElementById('metadataPath').value.trim();
        if (!path) { alert('Please enter a folder path.'); return; }
        const statusDiv = document.getElementById('metadataStatus');
        statusDiv.textContent = 'Scanning...';
        try {
            const res = await fetch('/metadata/scan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ path: path })
            });
            const data = await res.json();
            if (data.error) {
                statusDiv.textContent = '❌ ' + data.error;
                return;
            }
            currentMetadata = data;
            statusDiv.textContent = `✅ Found ${data.length} files with metadata.`;
            renderMetadataList(data);
        } catch (e) {
            statusDiv.textContent = '❌ Error: ' + e;
        }
    }

    function renderMetadataList(items) {
        const container = document.getElementById('metadataList');
        if (!items.length) {
            container.innerHTML = '<p style="color:var(--text-muted);">No metadata files found.</p>';
            return;
        }
        let html = '';
        for (const item of items) {
            html += `
            <div class="metadata-item">
                <div>
                    <div class="title">${escapeHTML(item.title) || 'Untitled'}</div>
                    <div class="uploader">${escapeHTML(item.uploader) || 'Unknown'} · ${escapeHTML(item.upload_date) || ''}</div>
                </div>
                <div class="actions">
                    <button onclick="openEditModal('${encodeURIComponent(item.info_file)}')">✏️ Edit</button>
                </div>
            </div>
            `;
        }
        container.innerHTML = html;
    }

    function openEditModal(infoFile) {
        infoFile = decodeURIComponent(infoFile);
        const item = currentMetadata.find(i => i.info_file === infoFile);
        if (!item) return;
        document.getElementById('editInfoFile').value = infoFile;
        document.getElementById('editTitle').value = item.title || '';
        document.getElementById('editUploader').value = item.uploader || '';
        document.getElementById('editDate').value = item.upload_date || '';
        document.getElementById('editDescription').value = item.description || '';
        document.getElementById('editTags').value = (item.tags || []).join(', ');
        document.getElementById('editModal').classList.add('active');
    }

    function closeModal() {
        document.getElementById('editModal').classList.remove('active');
    }

    async function saveMetadata() {
        const infoFile = document.getElementById('editInfoFile').value;
        const data = {
            info_file: infoFile,
            title: document.getElementById('editTitle').value,
            uploader: document.getElementById('editUploader').value,
            upload_date: document.getElementById('editDate').value,
            description: document.getElementById('editDescription').value,
            tags: document.getElementById('editTags').value.split(',').map(s => s.trim()).filter(Boolean)
        };
        try {
            const res = await fetch('/metadata/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.status === 'updated') {
                alert('Metadata updated successfully!');
                closeModal();
                scanMetadata();
            } else {
                alert('Error: ' + (result.error || 'Unknown error'));
            }
        } catch (e) {
            alert('Error: ' + e);
        }
    }

    // ---------- Tmp Reorder ----------
    let tmpReorgInterval = null;
    async function startTmpReorg() {
        const btn = document.getElementById('tmpReorgBtn');
        btn.disabled = true;
        btn.textContent = '⏳ Starting...';
        const res = await fetch('/tmp-reorder', { method: 'POST' });
        const data = await res.json();
        if (data.status === 'already running') {
            alert('Already running.');
            btn.disabled = false;
            btn.textContent = '🚀 Reorder Tmp Files';
            return;
        }
        if (tmpReorgInterval) clearInterval(tmpReorgInterval);
        document.getElementById('tmpReorgLog').textContent = 'Loading logs...';
        document.getElementById('tmpReorgStatus').textContent = 'Running...';
        document.getElementById('tmpReorgStatus').className = 'utility-status running';
        tmpReorgInterval = setInterval(fetchTmpReorgLogs, 1500);
        fetchTmpReorgLogs();
        btn.textContent = '🔄 Running...';
    }

    async function fetchTmpReorgLogs() {
        try {
            const res = await fetch('/tmp-reorder-logs');
            const data = await res.json();
            const logDiv = document.getElementById('tmpReorgLog');
            const statusDiv = document.getElementById('tmpReorgStatus');
            logDiv.textContent = data.logs.join('\\n');
            if (!data.running) {
                statusDiv.textContent = '✅ Completed';
                statusDiv.className = 'utility-status done';
                if (tmpReorgInterval) {
                    clearInterval(tmpReorgInterval);
                    tmpReorgInterval = null;
                    document.getElementById('tmpReorgBtn').disabled = false;
                    document.getElementById('tmpReorgBtn').textContent = '🚀 Reorder Tmp Files';
                }
            } else {
                statusDiv.textContent = '🔄 Running...';
                statusDiv.className = 'utility-status running';
                document.getElementById('tmpReorgBtn').disabled = true;
                document.getElementById('tmpReorgBtn').textContent = '🔄 Running...';
            }
            logDiv.scrollTop = logDiv.scrollHeight;
        } catch (_) {}
    }

    // ---------- Archive Manager ----------
    async function loadArchive() {
        const container = document.getElementById('archiveList');
        container.innerHTML = 'Loading...';
        try {
            const res = await fetch('/archive');
            const data = await res.json();
            if (!data.length) {
                container.innerHTML = '<p style="color:var(--text-muted);">No entries in archive.</p>';
                return;
            }
            let html = '';
            for (const entry of data) {
                html += `
                <div class="archive-entry">
                    <span class="entry-text">${escapeHTML(entry.entry)}</span>
                    <button class="delete-btn" onclick="deleteArchiveEntry('${encodeURIComponent(entry.entry)}')">Delete</button>
                </div>
                `;
            }
            container.innerHTML = html;
        } catch (e) {
            container.innerHTML = '<p style="color:#cf6f6f;">Error loading archive: ' + e + '</p>';
        }
    }

    async function deleteArchiveEntry(entry) {
        entry = decodeURIComponent(entry);
        if (!confirm(`Delete this entry from the archive?`)) return;
        try {
            const res = await fetch('/archive/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ entry: entry })
            });
            const data = await res.json();
            if (data.status === 'deleted') {
                loadArchive();
            } else {
                alert('Error deleting entry: ' + (data.error || 'unknown'));
            }
        } catch (e) {
            alert('Error: ' + e);
        }
    }

    // ---------- Metadata Editor ----------
    let editorFiles = [];

    async function scanEditorFiles() {
        const path = document.getElementById('editorPath').value.trim();
        if (!path) { alert('Please enter a folder path.'); return; }
        const statusDiv = document.getElementById('editorStatus');
        const fileList = document.getElementById('fileList');
        statusDiv.textContent = 'Scanning...';
        try {
            const res = await fetch('/metadata/editor/scan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ path: path })
            });
            const data = await res.json();
            if (data.error) {
                statusDiv.textContent = '❌ ' + data.error;
                return;
            }
            editorFiles = data;
            statusDiv.textContent = `✅ Found ${data.length} files. Click a file to edit.`;
            renderFileList(data);
        } catch (e) {
            statusDiv.textContent = '❌ Error: ' + e;
        }
    }

    function renderFileList(files) {
        const container = document.getElementById('fileList');
        if (!files.length) {
            container.innerHTML = '<p style="color:var(--text-muted);">No supported files found.</p>';
            return;
        }
        let html = '';
        for (const file of files) {
            const title = file.title || file.file_path.split('/').pop();
            const tags = `${escapeHTML(file.artist) || 'Unknown'} · ${escapeHTML(file.album) || ''} ${file.date ? '· ' + escapeHTML(file.date) : ''}`;
            const hasCover = file.has_cover ? '🖼️' : '';
            html += `
            <div class="file-item" onclick="openEditorModal('${encodeURIComponent(file.file_path)}')">
                <span class="file-name">${escapeHTML(title)}</span>
                <span class="file-tags">${tags} ${hasCover}</span>
                <span style="font-size:0.7rem;color:var(--text-muted);">${escapeHTML(file.extension)}</span>
            </div>
            `;
        }
        container.innerHTML = html;
    }

    function openEditorModal(filePath) {
        filePath = decodeURIComponent(filePath);
        const file = editorFiles.find(f => f.file_path === filePath);
        if (!file) return;
        document.getElementById('editFilePath').value = filePath;
        document.getElementById('editTitle').value = file.title || '';
        document.getElementById('editArtist').value = file.artist || '';
        document.getElementById('editAlbum').value = file.album || '';
        document.getElementById('editDate').value = file.date || '';
        document.getElementById('editDescription').value = file.description || '';
        // Show current cover preview if exists
        const previewDiv = document.getElementById('currentCoverPreview');
        previewDiv.innerHTML = '';
        if (file.has_cover) {
            const base = file.file_path.replace(/\.[^.]*$/, '');
            // Try to find the cover image
            for (const ext of ['jpg', 'png', 'webp']) {
                const coverPath = base + '.' + ext;
                if (coverPath) {
                    previewDiv.innerHTML = `<img src="/media/${coverPath}" style="max-width:100px;max-height:100px;border-radius:4px;border:1px solid var(--border);">`;
                    break;
                }
            }
        }
        document.getElementById('editEditorModal').classList.add('active');
    }

    function closeEditorModal() {
        document.getElementById('editEditorModal').classList.remove('active');
    }

    // Handle form submission for metadata editor
    document.getElementById('editorForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        try {
            const res = await fetch('/metadata/editor/update', {
                method: 'POST',
                body: formData
            });
            const result = await res.json();
            if (result.status === 'updated') {
                alert('Metadata updated successfully!');
                closeEditorModal();
                // Refresh file list
                scanEditorFiles();
            } else {
                alert('Error: ' + (result.error || 'Unknown error'));
            }
        } catch (e) {
            alert('Error: ' + e);
        }
    });


    // ---------- Manage Users ----------
    async function loadUsers() {
        const container = document.getElementById('userList');
        if (!container) return;
        container.innerHTML = 'Loading...';
        try {
            const res = await fetch('/api/users');
            const users = await res.json();
            if (users.error) { container.innerHTML = `<span style="color:#cf6f6f;">${users.error}</span>`; return; }
            
            let html = '<table style="width:100%; text-align:left; border-collapse:collapse; font-size:0.9rem;">';
            html += '<tr><th style="padding:8px; border-bottom:1px solid var(--border);">Username</th><th style="padding:8px; border-bottom:1px solid var(--border);">Role</th><th style="padding:8px; border-bottom:1px solid var(--border);">Actions</th></tr>';
            
            for (const u of users) {
                const isSelf = u.username === window.currentUsername;
                html += `<tr>
                    <td style="padding:8px; border-bottom:1px solid var(--border);">${escapeHTML(u.username)}</td>
                    <td style="padding:8px; border-bottom:1px solid var(--border);">
                    <span class="card-status ${u.role === 'admin' ? 'done' : 'queued'}" style="margin:0;">${escapeHTML(u.role)}</span>
                    ${!u.totp_secret ? '<span class="card-status failed" style="margin:0 0 0 5px;" title="2FA is not enabled">No 2FA</span>' : ''}
                </td>
                    <td style="padding:8px; border-bottom:1px solid var(--border);">
                        ${isSelf ? '<span style="color:var(--text-muted);font-size:0.8rem;">(Current User)</span>' : `<button onclick="removeUser(${u.id}, '${encodeURIComponent(u.username)}')" style="background:#3a1a1a;color:#cf6f6f;border:none;border-radius:4px;padding:4px 8px;cursor:pointer;">🗑️ Remove</button>`}
                    </td>
                </tr>`;
            }
            html += '</table>';
            container.innerHTML = html;
        } catch (e) { container.innerHTML = `<span style="color:#cf6f6f;">Error: ${e}</span>`; }
    }

    async function addUser() {
        const u = document.getElementById('newUsername').value.trim();
        const p = document.getElementById('newPassword').value;
        const r = document.getElementById('newRole').value;
        if (!u || !p) { alert("Username and password required"); return; }
        
        try {
            const res = await fetch('/api/users/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username: u, password: p, role: r })
            });
            const data = await res.json();
            if (data.error) { alert(data.error); return; }
            alert('✅ User added successfully!');
            document.getElementById('newUsername').value = '';
            document.getElementById('newPassword').value = '';
            loadUsers();
        } catch (e) { alert("Error: " + e); }
    }

    async function removeUser(id, username) {
        username = decodeURIComponent(username);
        if (!confirm(`Are you sure you want to delete the user "${username}"?`)) return;
        try {
            const res = await fetch('/api/users/remove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: id })
            });
            const data = await res.json();
            if (data.error) { alert(data.error); return; }
            loadUsers();
        } catch (e) { alert("Error: " + e); }
    }

    // Load users when the Manage Users accordion is opened
    document.getElementById('manageUsersDetails').addEventListener('toggle', function() {
        if (this.open) loadUsers();
    });

    // ---------- Radio Manager ----------
    let radioPage = 1;

    async function checkRadioStatus() {
        const statusSpan = document.getElementById('radioStatusMsg');
        statusSpan.textContent = 'Checking...';
        try {
            const res = await fetch('/radio/status');
            const data = await res.json();
            if (data.installed) {
                statusSpan.innerHTML = '✅ ' + data.message;
            } else {
                statusSpan.innerHTML = '❌ ' + data.message;
            }
        } catch (e) {
            statusSpan.innerHTML = '❌ Error checking status';
        }
    }

    async function setRadioDb() {
        const path = document.getElementById('radioDbPath').value.trim();
        if (!path) { alert('Please enter a database path.'); return; }
        try {
            const res = await fetch('/radio/setdb', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ db_path: path })
            });
            const data = await res.json();
            if (data.status === 'success') {
                document.getElementById('radioStatusMsg').innerHTML = '✅ ' + data.message;
            } else {
                alert('Error: ' + data.error);
            }
        } catch (e) {
            alert('Error: ' + e);
        }
    }

    async function searchRadios(page = 1) {
        const query = document.getElementById('radioSearchInput').value.trim();
        const type = document.getElementById('radioSearchType').value;
        if (!query) { alert('Please enter a search query.'); return; }
        if (page < 1) page = 1;
        radioPage = page;
        
        const resultsDiv = document.getElementById('radioResults');
        resultsDiv.innerHTML = '<div style="color:var(--text-muted);">Searching...</div>';
        
        try {
            const res = await fetch('/radio/search', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ query, type, page })
            });
            const data = await res.json();
            if (data.error) {
                resultsDiv.innerHTML = '<p style="color:#cf6f6f;">❌ ' + data.error + '</p>';
                return;
            }
            if (!data.stations || data.stations.length === 0) {
                resultsDiv.innerHTML = '<p style="color:var(--text-muted);">No stations found.</p>';
                return;
            }
            let html = '<div style="font-weight:600; margin-bottom:8px;">Page ' + data.page + ' (found ~' + data.total + ' total):</div>';
            for (const station of data.stations) {
                html += `
                <div class="archive-entry">
                    <span class="entry-text"><strong>${escapeHTML(station.name)}</strong> ${station.country ? '· ' + escapeHTML(station.country) : ''}</span>
                    <div>
                        <button onclick="addRadio('${encodeURIComponent(station.url)}', '${encodeURIComponent(station.name)}')" style="background:#28a745;color:#fff;border:none;border-radius:4px;padding:2px 8px;cursor:pointer;">➕ Add</button>
                    </div>
                </div>
                `;
            }
            // Pagination controls
            html += `<div style="margin-top:12px; display:flex; gap:8px; justify-content:center;">
                <button onclick="searchRadios(${data.page - 1})" ${data.page <= 1 ? 'disabled' : ''} style="padding:4px 12px; background:var(--accent); color:#fff; border:none; border-radius:4px; cursor:pointer;">⬅ Previous</button>
                <span style="padding:4px 12px;">Page ${data.page}</span>
                <button onclick="searchRadios(${data.page + 1})" ${!data.has_next ? 'disabled' : ''} style="padding:4px 12px; background:var(--accent); color:#fff; border:none; border-radius:4px; cursor:pointer;">Next ➡</button>
            </div>`;
            resultsDiv.innerHTML = html;
        } catch (e) {
            resultsDiv.innerHTML = '<p style="color:#cf6f6f;">❌ Error: ' + e + '</p>';
        }
    }

    async function addRadio(url, name) {
        url = decodeURIComponent(url);
        name = decodeURIComponent(name);
        if (!confirm(`Add "${name}" to Navidrome?`)) return;
        try {
            const res = await fetch('/radio/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url, name })
            });
            const data = await res.json();
            if (data.status === 'success') {
                alert('✅ Radio added successfully!');
                // Refresh the list if visible
                listRadios();
            } else {
                alert('❌ Failed: ' + data.error);
            }
        } catch (e) {
            alert('Error: ' + e);
        }
    }

    async function addRadioManually() {
        const url = document.getElementById('radioUrlInput').value.trim();
        const name = document.getElementById('radioNameInput').value.trim();
        if (!url) { alert('Please enter a stream URL.'); return; }
        await addRadio(url, name);
        document.getElementById('radioUrlInput').value = '';
        document.getElementById('radioNameInput').value = '';
    }

    async function listRadios() {
        const resultsDiv = document.getElementById('radioResults');
        resultsDiv.innerHTML = '<div style="color:var(--text-muted);">Loading...</div>';
        try {
            const res = await fetch('/radio/list');
            const data = await res.json();
            if (data.error) {
                resultsDiv.innerHTML = '<p style="color:#cf6f6f;">❌ ' + data.error + '</p>';
                return;
            }
            if (!data.stations || data.stations.length === 0) {
                resultsDiv.innerHTML = '<p style="color:var(--text-muted);">No stations added yet.</p>';
                return;
            }
            let html = '<div style="font-weight:600; margin-bottom:8px;">Added stations (' + data.stations.length + '):</div>';
            for (const station of data.stations) {
                html += `
                <div class="archive-entry">
                    <span class="entry-text"><strong>${escapeHTML(station.name)}</strong> · ${escapeHTML(station.url)}</span>
                    <div>
                        <button onclick="removeRadio('${encodeURIComponent(station.url)}')" style="background:#dc3545;color:#fff;border:none;border-radius:4px;padding:2px 8px;cursor:pointer;">🗑️ Remove</button>
                    </div>
                </div>
                `;
            }
            resultsDiv.innerHTML = html;
        } catch (e) {
            resultsDiv.innerHTML = '<p style="color:#cf6f6f;">❌ Error: ' + e + '</p>';
        }
    }

    async function removeRadio(url) {
        url = decodeURIComponent(url);
        if (!confirm('Remove this radio station?')) return;
        try {
            const res = await fetch('/radio/remove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url })
            });
            const data = await res.json();
            if (data.status === 'success') {
                alert('✅ Station removed.');
                listRadios();
            } else {
                alert('❌ Failed: ' + data.error);
            }
        } catch (e) {
            alert('Error: ' + e);
        }
    }

    // ---------- Settings form ----------
    async function loadSettings() {
        try {
            const res = await fetch('/settings');
            const data = await res.json();
            for (const [key, value] of Object.entries(data)) {
                const el = document.getElementById(key);
                if (el) {
                    if (el.type === 'checkbox') {
                        el.checked = value === true;
                    } else {
                        el.value = value || '';
                    }
                }
            }
        } catch (_) {}
    }

    document.getElementById('settingsForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(e.target);
        const res = await fetch('/settings', { method: 'POST', body: data });
        const result = await res.json();
        document.getElementById('settingsStatus').textContent = '✅ ' + result.status;
    });

    
    async function loadProfile() {
        try {
            const res = await fetch('/api/me');
            if (!res.ok) return;
            const user = await res.json();
            document.getElementById('userWidget').style.display = 'block';
            document.getElementById('userDisplayName').textContent = user.display_name || user.username;
            document.getElementById('userRoleBadge').textContent = user.role;
            const avatarSrc = user.avatar ? '/avatars/' + user.avatar : 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="%232c2c36"/><text x="50" y="55" font-size="40" text-anchor="middle" fill="%238899aa" font-family="sans-serif">?</text></svg>';
            document.getElementById('userAvatarDisplay').src = avatarSrc;
            if(document.getElementById('modalAvatarPreview')) document.getElementById('modalAvatarPreview').src = avatarSrc;
            if(document.getElementById('accountDisplayName')) document.getElementById('accountDisplayName').value = user.display_name || '';
            if(document.getElementById('accountEmail')) document.getElementById('accountEmail').value = user.email || '';
            
            // Update 2FA UI state
            if (document.getElementById('2fa-disabled-view')) {
                if (user.totp_secret) {
                    document.getElementById('2fa-disabled-view').style.display = 'none';
                    document.getElementById('2fa-setup-view').style.display = 'none';
                    document.getElementById('2fa-enabled-view').style.display = 'block';
                } else {
                    document.getElementById('2fa-disabled-view').style.display = 'block';
                    document.getElementById('2fa-setup-view').style.display = 'none';
                    document.getElementById('2fa-enabled-view').style.display = 'none';
                }
            }
            
            // Update 2FA UI state
            if (document.getElementById('2fa-disabled-view')) {
                if (user.totp_secret) {
                    document.getElementById('2fa-disabled-view').style.display = 'none';
                    document.getElementById('2fa-setup-view').style.display = 'none';
                    document.getElementById('2fa-enabled-view').style.display = 'block';
                } else {
                    document.getElementById('2fa-disabled-view').style.display = 'block';
                    document.getElementById('2fa-setup-view').style.display = 'none';
                    document.getElementById('2fa-enabled-view').style.display = 'none';
                }
            }
        } catch (e) { console.error("Profile load error", e); }
    }

    function switchAccountTab(tabId, btn) {
        document.querySelectorAll('.account-tab-content').forEach(el => el.style.display = 'none');
        document.querySelectorAll('.tab-btn').forEach(el => {
            el.style.color = 'var(--text-muted)';
            el.style.borderBottom = 'none';
        });
        document.getElementById('tab-' + tabId).style.display = 'block';
        btn.style.color = 'var(--accent)';
        btn.style.borderBottom = '2px solid var(--accent)';
        btn.style.marginBottom = '-1px';
    }


    // ---------- 2FA ----------
    let currentTotpSecret = null;

    function renderProfile2FA(user) {
        if (user.totp_secret) {
            document.getElementById('2fa-disabled-view').style.display = 'none';
            document.getElementById('2fa-setup-view').style.display = 'none';
            document.getElementById('2fa-enabled-view').style.display = 'block';
        } else {
            document.getElementById('2fa-disabled-view').style.display = 'block';
            document.getElementById('2fa-setup-view').style.display = 'none';
            document.getElementById('2fa-enabled-view').style.display = 'none';
        }
    }

    async function start2FASetup() {
        try {
            const res = await fetch('/api/me/2fa/setup', { method: 'POST' });
            const data = await res.json();
            currentTotpSecret = data.secret;
            
            // Render QR using Google Charts API (simple, no extra python deps)
            const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(data.url)}`;
            document.getElementById('2fa-qr-code').innerHTML = `<img src="${qrUrl}" alt="QR Code">`;
            
            document.getElementById('2fa-disabled-view').style.display = 'none';
            document.getElementById('2fa-setup-view').style.display = 'block';
        } catch (e) { alert('Error starting setup'); }
    }

    async function confirm2FA() {
        const code = document.getElementById('2fa-verify-code').value;
        if (code.length !== 6) { alert("Enter a 6-digit code"); return; }
        
        try {
            const res = await fetch('/api/me/2fa/enable', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ secret: currentTotpSecret, code: code })
            });
            const data = await res.json();
            if (data.error) { alert(data.error); return; }
            alert('✅ 2FA Successfully Enabled!');
            loadProfile(); // refresh state
        } catch (e) { alert('Error verifying code'); }
    }

    async function disable2FA() {
        if (!confirm("Are you sure you want to disable 2FA? This makes your account less secure.")) return;
        try {
            const res = await fetch('/api/me/2fa/disable', { method: 'POST' });
            const data = await res.json();
            if (data.status === 'success') {
                alert('2FA Disabled.');
                loadProfile();
            }
        } catch (e) { alert('Error disabling 2FA'); }
    }

    function openAccountModal() { document.getElementById('accountModal').classList.add('active'); }
    function closeAccountModal() { document.getElementById('accountModal').classList.remove('active'); }
    document.getElementById('accountTheme').addEventListener('change', function(e) {
        setTheme(e.target.value);
    });

    document.getElementById('accountAvatarFile').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(evt) { document.getElementById('modalAvatarPreview').src = evt.target.result; };
            reader.readAsDataURL(file);
        }
    });
    document.getElementById('accountForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        try {
            const res = await fetch('/api/me/update', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.error) { alert('Error: ' + data.error); return; }
            alert('Account updated!');
            closeAccountModal();
            loadProfile();
        } catch (err) { alert('Error saving profile'); }
    });
    async function requestPasswordReset() {
        if (!confirm("Generate a password reset link? (It will be printed to the server log).")) return;
        try {
            const res = await fetch('/api/me/reset-request', { method: 'POST' });
            const data = await res.json();
            if (data.error) { alert(data.error); return; }
            alert(data.message);
        } catch (e) { alert('Error requesting reset'); }
    }
    loadProfile();

    // ---------- Polling ----------
    setInterval(loadQueue, 1500);
    loadQueue();
    loadSettings();
    setTimeout(fetchReorgLogs, 1000);
    setTimeout(fetchTmpReorgLogs, 1000);
    setTimeout(checkRadioStatus, 1500);
</script>

    <!-- Theme Modal & JS -->
    <div id="themeModal" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.8); z-index:99999; align-items:center; justify-content:center;">
        <div style="background:var(--card); padding:24px; border-radius:16px; width:360px; border:1px solid var(--border); max-height: 90vh; overflow-y: auto; box-shadow: 0 24px 64px rgba(0,0,0,0.5);">
            <h3 style="margin-bottom:15px; color:var(--text);">🎨 Customize Theme</h3>
            
            <select id="themePreset" onchange="loadPreset()" style="width:100%; margin-bottom:15px; padding:10px; border-radius:8px; border:1px solid var(--border); background:var(--bg); color:var(--text);">
                <option value="custom">-- Custom / Manual --</option>
                <option value="default">Default Dark</option>
                <option value="system">System (Auto)</option>
                <option value="light">Light Mode</option>
                <option value="cyberpunk">Cyberpunk (Neon)</option>
                <option value="christmas">Christmas 🎄</option>
                <option value="halloween">Halloween 🎃</option>
                <option value="birthday">Birthday 🎂</option>
                <option value="midnight">Midnight Blue</option>
                <option value="forest">Forest Green</option>
                <option value="sunset">Sunset Orange</option>
                <option value="matrix">Matrix</option>
            </select>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:15px;">
                <label style="color:var(--text); font-size:0.85rem;">Background<input type="color" id="theme-bg" style="width:100%; height:36px; border-radius:8px; border:1px solid var(--border); cursor:pointer;"></label>
                <label style="color:var(--text); font-size:0.85rem;">Sidebar<input type="color" id="theme-sidebar" style="width:100%; height:36px; border-radius:8px; border:1px solid var(--border); cursor:pointer;"></label>
                <label style="color:var(--text); font-size:0.85rem;">Card<input type="color" id="theme-card" style="width:100%; height:36px; border-radius:8px; border:1px solid var(--border); cursor:pointer;"></label>
                <label style="color:var(--text); font-size:0.85rem;">Border<input type="color" id="theme-border" style="width:100%; height:36px; border-radius:8px; border:1px solid var(--border); cursor:pointer;"></label>
                <label style="color:var(--text); font-size:0.85rem;">Text<input type="color" id="theme-text" style="width:100%; height:36px; border-radius:8px; border:1px solid var(--border); cursor:pointer;"></label>
                <label style="color:var(--text); font-size:0.85rem;">Accent<input type="color" id="theme-accent" style="width:100%; height:36px; border-radius:8px; border:1px solid var(--border); cursor:pointer;"></label>
            </div>

            <div style="margin-bottom:15px; border-top:1px solid var(--border); padding-top:15px;">
                <div style="display:flex; gap:8px;">
                    <input type="text" id="customThemeName" placeholder="My Custom Theme" style="flex:1; padding:8px; border-radius:8px; border:1px solid var(--border); background:var(--bg); color:var(--text);">
                    <button onclick="saveCustomPreset()" style="background:var(--border); border:none; color:var(--text); padding:8px 12px; border-radius:8px; cursor:pointer;">Save</button>
                </div>
                <select id="customPresetsList" onchange="loadCustomPreset()" style="width:100%; margin-top:8px; padding:8px; border-radius:8px; border:1px solid var(--border); background:var(--bg); color:var(--text);">
                    <option value="">-- Load Custom Theme --</option>
                </select>
            </div>

            <div style="display:flex; gap:10px; justify-content:space-between;">
                <button onclick="resetTheme()" style="background:transparent; border:1px solid #ff4444; color:#ff4444; padding:8px 16px; border-radius:8px; cursor:pointer;">Reset</button>
                <div style="display:flex; gap:10px;">
                    <button onclick="document.getElementById('themeModal').style.display='none'" style="background:transparent; border:1px solid var(--border); color:var(--text); padding:8px 16px; border-radius:8px; cursor:pointer;">Cancel</button>
                    <button onclick="saveTheme()" style="background:var(--accent); border:none; color:white; padding:8px 16px; border-radius:8px; cursor:pointer;">Save</button>
                </div>
            </div>
        </div>
    </div>
    <script>
    const presets = {
        get system() {
            return window.matchMedia('(prefers-color-scheme: light)').matches ? 
                  { bg: '#f4f5f7', sidebar: '#e5e7eb', card: '#ffffff', text: '#1a1a20', accent: '#0066cc', border: '#d1d5db' } : 
                  { bg: '#0f0f11', sidebar: '#141418', card: '#1a1a20', text: '#eaeef2', accent: '#5b7cfa', border: '#2c2c36' };
        },
        'default': { bg: '#0f0f11', sidebar: '#141418', card: '#1a1a20', text: '#eaeef2', accent: '#5b7cfa', border: '#2c2c36' },
        'light': { bg: '#f4f5f7', sidebar: '#e5e7eb', card: '#ffffff', text: '#1a1a20', accent: '#0066cc', border: '#d1d5db' },
        'cyberpunk': { bg: '#0a001a', sidebar: '#12002b', card: '#1a0033', text: '#00ffff', accent: '#ff00ff', border: '#ff00ff' },
        'christmas': { bg: '#061a0d', sidebar: '#03210e', card: '#0a2e17', text: '#ffffff', accent: '#ff3333', border: '#2e8b57' },
        'halloween': { bg: '#1a0f00', sidebar: '#140c00', card: '#2b1800', text: '#ffcc00', accent: '#ff6600', border: '#4d2800' },
        'birthday': { bg: '#1a0a1a', sidebar: '#140014', card: '#2e0e2e', text: '#ffffff', accent: '#ff66b2', border: '#ffcc00' },
        'midnight': { bg: '#0a1128', sidebar: '#070c1c', card: '#121e42', text: '#e0e7ff', accent: '#4f46e5', border: '#1e2d5a' },
        'forest': { bg: '#0b1a12', sidebar: '#06120c', card: '#122b1e', text: '#d1fae5', accent: '#10b981', border: '#1e3f2c' },
        'sunset': { bg: '#2b120e', sidebar: '#1f0d0a', card: '#421a14', text: '#ffedd5', accent: '#f97316', border: '#5e2419' },
        'matrix': { bg: '#000000', sidebar: '#050505', card: '#0a0a0a', text: '#00ff00', accent: '#00aa00', border: '#004400' }
    };

    function openThemeModal() {
        document.getElementById('themeModal').style.display = 'flex';
    }

    function loadPreset() {
        const selected = document.getElementById('themePreset').value;
        if (selected === 'custom') return;
        const colors = presets[selected];
        if (!colors) return;
        document.getElementById('theme-bg').value = colors.bg;
        document.getElementById('theme-sidebar').value = colors.sidebar;
        document.getElementById('theme-card').value = colors.card;
        document.getElementById('theme-text').value = colors.text;
        document.getElementById('theme-accent').value = colors.accent;
        document.getElementById('theme-border').value = colors.border;
    }

    document.addEventListener('DOMContentLoaded', () => {
        const c = getComputedStyle(document.documentElement);
        document.getElementById('theme-bg').value = c.getPropertyValue('--bg').trim() || '#0f0f11';
        document.getElementById('theme-sidebar').value = c.getPropertyValue('--sidebar').trim() || '#141418';
        document.getElementById('theme-card').value = c.getPropertyValue('--card').trim() || '#1a1a20';
        document.getElementById('theme-text').value = c.getPropertyValue('--text').trim() || '#eaeef2';
        document.getElementById('theme-accent').value = c.getPropertyValue('--accent').trim() || '#5b7cfa';
        document.getElementById('theme-border').value = c.getPropertyValue('--border').trim() || '#2c2c36';
        updateCustomDropdown();
    });

    function getCurrentColors() {
        return {
            'bg': document.getElementById('theme-bg').value,
            'sidebar': document.getElementById('theme-sidebar').value,
            'card': document.getElementById('theme-card').value,
            'text': document.getElementById('theme-text').value,
            'accent': document.getElementById('theme-accent').value,
            'border': document.getElementById('theme-border').value
        };
    }

    function applyAndSave(colors, presetName) {
        if (presetName !== 'system') {
            fetch('/api/theme', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({colors: colors})
        }).then(r => r.json()).then(d => {
            if(d.success) {
                for (const [k, v] of Object.entries(colors)) {
                    document.documentElement.style.setProperty('--' + k, v);
                }
                document.getElementById('themeModal').style.display='none';
            } else { alert('Error saving theme'); }
        });
    }

    function saveTheme() { applyAndSave(getCurrentColors()); }
    function resetTheme() {
        applyAndSave(presets['default']);
        document.getElementById('themePreset').value = 'default';
        loadPreset();
    }

    function saveCustomPreset() {
        const name = document.getElementById('customThemeName').value.trim();
        if (!name) return alert('Please enter a name');
        const customs = JSON.parse(localStorage.getItem('mg_custom_themes') || '{}');
        customs[name] = getCurrentColors();
        localStorage.setItem('mg_custom_themes', JSON.stringify(customs));
        document.getElementById('customThemeName').value = '';
        updateCustomDropdown();
        alert('Custom theme saved!');
    }

    function updateCustomDropdown() {
        const customs = JSON.parse(localStorage.getItem('mg_custom_themes') || '{}');
        const sel = document.getElementById('customPresetsList');
        sel.innerHTML = '<option value="">-- Load Custom Theme --</option>';
        for (const name in customs) {
            sel.innerHTML += `<option value="${name}">${name}</option>`;
        }
    }

    function loadCustomPreset() {
        const name = document.getElementById('customPresetsList').value;
        if (!name) return;
        const customs = JSON.parse(localStorage.getItem('mg_custom_themes') || '{}');
        const colors = customs[name];
        if (!colors) return;
        document.getElementById('theme-bg').value = colors.bg;
        document.getElementById('theme-sidebar').value = colors.sidebar;
        document.getElementById('theme-card').value = colors.card;
        document.getElementById('theme-text').value = colors.text;
        document.getElementById('theme-accent').value = colors.accent;
        document.getElementById('theme-border').value = colors.border;
        document.getElementById('themePreset').value = 'custom';
    }
    
    async function loadProfile() {
        try {
            const res = await fetch('/api/me');
            if (!res.ok) return;
            const user = await res.json();
            document.getElementById('userWidget').style.display = 'block';
            document.getElementById('userDisplayName').textContent = user.display_name || user.username;
            document.getElementById('userRoleBadge').textContent = user.role;
            const avatarSrc = user.avatar ? '/avatars/' + user.avatar : 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="%232c2c36"/><text x="50" y="55" font-size="40" text-anchor="middle" fill="%238899aa" font-family="sans-serif">?</text></svg>';
            document.getElementById('userAvatarDisplay').src = avatarSrc;
            if(document.getElementById('modalAvatarPreview')) document.getElementById('modalAvatarPreview').src = avatarSrc;
            if(document.getElementById('accountDisplayName')) document.getElementById('accountDisplayName').value = user.display_name || '';
            if(document.getElementById('accountEmail')) document.getElementById('accountEmail').value = user.email || '';
        } catch(e) { console.error("Profile load failed", e); }
    }
    
    function openAccountModal() {
        document.getElementById('accountModal').classList.add('active');
        loadProfile(); // Refresh data when opened
    }

    
    // Trigger loadProfile as soon as the page loads
    window.addEventListener('DOMContentLoaded', () => {
        loadProfile();
    });
    
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(() => {
            // Optional: show a quick toast or alert
            console.log('Copied to clipboard:', text);
        }).catch(err => {
            console.error('Failed to copy: ', err);
        });
    }
</script>
</body>
</html>
    '''.replace('{theme}', theme)


    admin_style = "" if session.get("role") == "admin" else "display:none;"
    role_class = "role-admin" if session.get("role") == "admin" else "role-user"
    return html.replace('{admin_style}', admin_style).replace('{role_class}', role_class).replace('{theme_colors}', (user.get('theme_colors') or '{}'))

if __name__ == "__main__":
    if len(sys.argv) >= 2 and sys.argv[1] == "set-password":
        import getpass
        print("MediaGrabber \u2014 set admin password")
        existing = load_auth() or {}
        username = input(f"Username [{existing.get('username', 'christopher')}]: ").strip() \
                   or existing.get("username", "christopher")
        while True:
            pw1 = getpass.getpass("Password (min 8 chars): ")
            if len(pw1) < 8:
                print("Too short, try again.")
                continue
            pw2 = getpass.getpass("Confirm: ")
            if pw1 != pw2:
                print("Mismatch, try again.")
                continue
            break
        save_auth({
            "username": username,
            "password_hash": generate_password_hash(pw1),
            "secret_key": existing.get("secret_key") or secrets.token_hex(32),
            "created": existing.get("created") or datetime.now(timezone.utc).isoformat(),
        })
        print(f"\u2705 Credentials saved to {AUTH_FILE}")
        sys.exit(0)
    app.run(host="0.0.0.0", port=8080, debug=False)
