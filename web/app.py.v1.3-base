def _allowed_media_roots():
    s = load_settings()
    return [os.path.realpath(x) for x in {
        s.get("yt_base_path") or DEFAULT_YT_DIR,
        s.get("music_base_path") or DEFAULT_MUSIC_DIR,
        s.get("gallery_base_path") or DEFAULT_GALLERY_DIR,
        "/tmp/mediagrabber",
    }]

def _safe_media_path(path):
    full = os.path.realpath(os.path.join("/", path))
    for root in _allowed_media_roots():
        if full == root or full.startswith(root + os.sep):
            return full
    return None

@app.route("/media/<path:path>")
def media(path):
    if not path:
        return "Invalid", 400
    full = _safe_media_path(path)
    if not full or not os.path.isfile(full):
        return "Forbidden", 403
    return send_from_directory(os.path.dirname(full), os.path.basename(full))

