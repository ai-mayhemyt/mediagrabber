@app.route("/log/<job_id>")
def log_page(job_id):
    with LOCK:
        job = QUEUE.get(job_id)
        if not job:
            return "Job not found", 404
        log_lines = job.get("log", [])
        status = job.get("status", "unknown")
        url = job.get("url", "")
    return render_template_string("""
<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Log</title>
<style>body{background:#0f0f11;color:#eaeef2;font-family:sans-serif;padding:20px;max-width:900px;margin:auto;}
.back{color:#8899aa;text-decoration:none;display:inline-block;margin-bottom:20px;}
.back:hover{color:#eaeef2;}
pre{background:#0a0a0e;padding:20px;border-radius:8px;font-size:.85rem;max-height:80vh;overflow-y:auto;white-space:pre-wrap;word-break:break-word;color:#b0c0d0;border:1px solid #1a1a22;}
.status{color:#6fcf97;}.failed{color:#cf6f6f;}
</style>
</head><body>
<a href="/" class="back">← Back to queue</a>
<h2>Log for <span style="font-family:monospace;">{{ job_id[:8] }}</span></h2>
<p>Status: <span class="status">{{ status }}</span> | URL: {{ url }}</p>
<pre>{{ log_lines | join('\\n') }}</pre>
</body></html>
    """, job_id=job_id, log_lines=log_lines, status=status, url=url)

