def parse_archive_line(line):
    line = (line or "").strip()
    if not line:
        return None, None
    parts = line.split(None, 1)
    if len(parts) == 1:
        return "youtube", "https://www.youtube.com/watch?v=" + parts[0]
    key, rest = parts[0].lower(), parts[1].strip()
    if key in ("youtube", "youtube:tab"):
        if not rest.startswith("http"):
            rest = "https://www.youtube.com/watch?v=" + rest
        return "youtube", rest
    if key == "ytmusic":
        if not rest.startswith("http"):
            rest = "https://music.youtube.com/watch?v=" + rest
        return "ytmusic", rest
    if key == "spotify":
        return "spotify", rest
    if key in ("instagram", "tiktok"):
        return "gallery", rest
    return "other", rest




