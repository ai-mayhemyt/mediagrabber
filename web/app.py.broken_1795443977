    function openEditorModal(filePath) {
        filePath = decodeURIComponent(filePath);
        const file = editorFiles.find(f => f.file_path === filePath);
        if (!file) return;
        document.getElementById('editFilePath').value = filePath;
        document.getElementById('editTitle').value = file.title || '';
        document.getElementById('editArtist').value = file.artist || '';
        document.getElementById('editAlbum').value = file.album || '';
        document.getElementById('editDate').value = file.date || '';
        document.getElementById('editDescription').value = file.description || '';
        // Show current cover preview if exists
        const previewDiv = document.getElementById('currentCoverPreview');
        previewDiv.innerHTML = '';
        if (file.has_cover) {
            const base = file.file_path.replace(/\.[^.]*$/, '');
            // Try to find the cover image
            for (const ext of ['jpg', 'png', 'webp']) {
                const coverPath = base + '.' + ext;
                if (coverPath) {
                    previewDiv.innerHTML = `<img src="/media/${coverPath}" style="max-width:100px;max-height:100px;border-radius:4px;border:1px solid var(--border);">`;
