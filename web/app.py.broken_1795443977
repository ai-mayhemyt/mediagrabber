@app.route("/api/scan-media", methods=["POST"])
def scan_media():
    settings = load_settings()
    jf_url = settings.get("jellyfin_url", "").strip()
    jf_key = settings.get("jellyfin_api_key", "").strip()
    
    print(f"Attempting Jellyfin scan on: {jf_url} with key: {jf_key[:5]}...")
    
    if not jf_url or not jf_key:
        return jsonify({"error": "Jellyfin URL or API Key not configured in Settings."}), 400
        
    try:
        import requests
        r = requests.post(f"{jf_url.rstrip('/')}/Library/Refresh", headers={"X-Emby-Token": jf_key}, timeout=10)
        print(f"Jellyfin response: {r.status_code}")
        if r.status_code in (200, 204):
            return jsonify({"success": True, "message": "Jellyfin scan triggered!"})
        return jsonify({"error": f"Jellyfin returned HTTP {r.status_code}"}), 500
    except Exception as e:
        print(f"Jellyfin error: {e}")
        return jsonify({"error": str(e)}), 500

