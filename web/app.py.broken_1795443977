            const tags = `${escapeHTML(file.artist) || 'Unknown'} · ${escapeHTML(file.album) || ''} ${file.date ? '· ' + escapeHTML(file.date) : ''}`;
            const hasCover = file.has_cover ? '🖼️' : '';
            html += `
            <div class="file-item" onclick="openEditorModal('${encodeURIComponent(file.file_path)}')">
                <span class="file-name">${escapeHTML(title)}</span>
                <span class="file-tags">${tags} ${hasCover}</span>
                <span style="font-size:0.7rem;color:var(--text-muted);">${escapeHTML(file.extension)}</span>
            </div>
