def scan_for_thumbnail(job):
    if not job:
        return None
    file_path = job.get("file")
    if file_path and os.path.exists(file_path):
        dir_path = os.path.dirname(file_path)
        for root, _, files in os.walk(dir_path):
            for f in files:
                if f.lower().endswith((".jpg", ".jpeg", ".png", ".webp")):
                    return os.path.join(root, f)
    output_dir = job.get("output_dir")
    if output_dir and os.path.exists(output_dir):
        for root, _, files in os.walk(output_dir):
            for f in files:
                if f.lower().endswith((".jpg", ".jpeg", ".png", ".webp")):
                    return os.path.join(root, f)
    return None

def refresh_library(dir_path):
    settings = load_settings()
    jf_url = settings.get("jellyfin_url", "").strip()
    jf_key = settings.get("jellyfin_api_key", "").strip()
    if jf_url:
        try:
            refresh_url = f"{jf_url.rstrip('/')}/Library/Refresh"
            params = {"path": dir_path}
            headers = {"X-Emby-Token": jf_key} if jf_key else {}
            r = requests.post(refresh_url, params=params, headers=headers, timeout=10)
            if r.status_code in (200, 204):
                print(f"✅ Jellyfin refresh triggered for {dir_path}")
            else:
                print(f"⚠️ Jellyfin refresh failed: {r.status_code}")
