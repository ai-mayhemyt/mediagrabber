<script>
    // ---------- Auth wrapper: redirect on 401 ----------
    (function () {
        const _fetch = window.fetch;
        window.fetch = function (url, opts) {
            return _fetch(url, opts).then(function (r) {
                if (r.status === 401) {
                    window.location.href = '/login?next=' + encodeURIComponent(location.pathname);
                    throw new Error('auth');
                }
                return r;
            });
        };
    })();

    // ---------- Theme ----------
    let currentTheme = '{theme}';
    function escapeHTML(str) {
        if (!str) return '';
        return String(str).replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag));
    }

    function setTheme(theme) {
        document.body.className = theme === 'light' ? 'light' : '';
        currentTheme = theme;
        const el = document.getElementById('currentTheme');
        if (el) el.textContent = theme;
        localStorage.setItem('mediagrabber-theme', theme);
        const fd = new FormData();
        fd.append('theme', theme);
        fetch('/api/me/update', { method: 'POST', body: fd }).catch(()=>{});
    }
    function toggleTheme() {
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        setTheme(newTheme);
    }
    const savedTheme = localStorage.getItem('mediagrabber-theme');
    if (savedTheme && savedTheme !== currentTheme) setTheme(savedTheme);

    // ---------- Show/hide mode selector ----------
    document.getElementById('url').addEventListener('input', function() {
        const url = this.value.trim();
        const isYoutube = url.includes('youtube.com') || url.includes('youtu.be');
        document.getElementById('modeSelector').style.display = isYoutube ? 'block' : 'none';
    });

    // ---------- View switching ----------
    document.querySelectorAll('.sidebar button[data-view]').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.sidebar button').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            const view = this.dataset.view;
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            document.getElementById('view-' + view).classList.add('active');
        });
    });

    // ---------- Queue functions ----------
    async function grab() {
        const text = document.getElementById('url').value.trim();
        if (!text) return;
        
        // Split by newlines, filter out empty lines
        const urls = text.split('\n').map(u => u.trim()).filter(u => u.length > 0);
        if (urls.length === 0) return;
        
        const mode = document.querySelector('input[name="mode"]:checked')?.value || 'video';
        document.getElementById('url').value = '';
        
        for (const url of urls) {
            await fetch('/grab', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'url=' + encodeURIComponent(url) + '&mode=' + mode
            });
        }
    }

    async function clearArchive(id) {
        if (!confirm('This will remove the URL from the archive and delete the job from the queue if it is completed. Proceed?')) return;
        const btn = document.querySelector(`.card[data-job-id="${id}"] .archive-btn`);
        if (btn) { btn.textContent = '⏳'; btn.disabled = true; }
        try {
            const res = await fetch('/clear-archive/' + id, { method: 'POST' });
            const data = await res.json();
            if (data.status === 'archive cleared' || data.status === 'archive cleared and job removed') {
                alert('Archive entry cleared');
            } else {
                alert('Error: ' + (data.error || 'unknown'));
            }
        } catch (e) {
            alert('Error: ' + e);
        }
        if (btn) { btn.disabled = false; btn.textContent = '🗑️ Archive'; }
    }

    async function retryJob(id) {
        if (!confirm('This will remove the existing entry from the archive and re-download the video. Proceed?')) return;
        const btn = document.querySelector(`.card[data-job-id="${id}"] .retry-btn`);
        if (btn) { btn.textContent = '⏳'; btn.disabled = true; }
        try {
            const res = await fetch('/retry/' + id, { method: 'POST' });
            const data = await res.json();
            if (data.status === 'retried') {
                alert('Retry started: ' + data.new_job_id);
            } else {
                alert('Retry failed: ' + (data.error || 'unknown error'));
            }
        } catch (e) {
            alert('Error: ' + e);
        }
        if (btn) { btn.disabled = false; btn.textContent = '🔄 Retry'; }
    }

    async function cancelJob(id) {
        if (!confirm('Cancel this job?')) return;
        await fetch('/cancel/' + id, { method: 'POST' });
    }
    async function removeJob(id) {
        if (!confirm('Remove this job from queue?')) return;
        await fetch('/remove/' + id, { method: 'DELETE' });
    }
    async function clearCompleted() {
        if (!confirm('Remove all completed (done/failed/cancelled) jobs?')) return;
        await fetch('/clear-completed', { method: 'POST' });
    }

    function renderQueue(data) {
        const q = document.getElementById('queue');
        const entries = Object.entries(data);
        if (!entries.length) {
            q.innerHTML = '<div class="empty">No jobs yet</div>';
            return;
        }
        let html = '';
        for (const [id, job] of entries) {
            const status = job.status || 'queued';
            const thumb = job.thumbnail ? `<img src="/media/${escapeHTML(job.thumbnail)}" alt="thumb">` : '';
            let engine = 'UNKNOWN';
            (job.log || []).forEach(line => {
                if (line.includes('Engine → SPOTIFY')) engine = 'SPOTIFY';
                else if (line.includes('Engine → GALLERY')) engine = 'GALLERY';
                else if (line.includes('Engine → YOUTUBE')) engine = 'YOUTUBE';
            });
            // YouTube Music tag
            if (engine === 'YOUTUBE' && job.url && job.url.includes('music.youtube.com')) {
                engine = 'YT MUSIC';
            }
            let thumbClass = '';
            if (engine === 'YOUTUBE') thumbClass = 'thumb-yt';
            else if (engine === 'SPOTIFY') thumbClass = 'thumb-spotify';
            else if (engine === 'GALLERY') thumbClass = 'thumb-gallery';
            let actions = '';
            if (status === 'running') {
                actions += `<button class="action-btn danger" onclick="cancelJob('${id}')">⏹ Cancel</button>`;
            } else if (status === 'queued') {
                actions += `<button class="action-btn danger" onclick="removeJob('${id}')">✕ Remove</button>`;
            } else {
                if (job.url) {
                    actions += `<button class="action-btn retry retry-btn" onclick="retryJob('${id}')">🔄 Retry</button>`;
                    actions += `<button class="action-btn archive archive-btn" onclick="clearArchive('${id}')">🗑️ Archive</button>`;
                }
                actions += `<button class="action-btn" onclick="removeJob('${id}')">✕ Remove</button>`;
            }
            const logBtn = `<a href="/log/${id}" class="action-btn">📋 Log</a>`;
            html += `
            <div class="card" data-job-id="${id}">
                <div class="card-top">
                    <div class="card-thumb ${thumbClass}">${thumb}</div>
                    <div class="card-info">
                        <div>
                            <span class="card-status ${status}">${status}</span>
                            <span class="engine-badge">${engine}</span>
                            <span style="float:right;">${logBtn} ${actions}</span>
                        </div>
                        <div class="card-url">${escapeHTML(job.url)}</div>
                        <div class="card-meta">
                            <span class="jobid">${id.slice(0,8)}</span>
                            ${job.file ? '<span style="color:#6fcf97;">✓ done</span>' : ''}
                        </div>
                    </div>
                </div>
                <div class="progress-wrap">
                    <div class="progress-label"><span>Progress</span><span>${Math.round(job.progress || 0)}%</span></div>
                    <div class="progress-bar"><div class="progress-fill" style="width:${job.progress || 0}%"></div></div>
                </div>
                ${job.file ? `<div class="file-path">📁 ${escapeHTML(job.file)}</div>` : ''}
            </div>`;
        }
        q.innerHTML = html;
    }

    async function loadQueue() {
        try {
            const res = await fetch('/queue', { cache: 'no-store' });
            const data = await res.json();
            renderQueue(data);
        } catch (_) {}
    }

    // ---------- Reorganize ----------
    let reorgInterval = null;
    async function startReorganize() {
        const btn = document.getElementById('reorgBtn');
        btn.disabled = true;
        btn.textContent = '⏳ Starting...';
        const res = await fetch('/reorganize', { method: 'POST' });
        const data = await res.json();
        if (data.status === 'already running') {
            alert('Already running.');
            btn.disabled = false;
            btn.textContent = '🚀 Start Reorganize';
            return;
        }
        if (reorgInterval) clearInterval(reorgInterval);
        document.getElementById('reorgLog').textContent = 'Loading logs...';
        document.getElementById('reorgStatus').textContent = 'Running...';
        document.getElementById('reorgStatus').className = 'utility-status running';
        reorgInterval = setInterval(fetchReorgLogs, 1500);
        fetchReorgLogs();
        btn.textContent = '🔄 Running...';
    }

    async function fetchReorgLogs() {
        try {
            const res = await fetch('/reorganize-logs');
            const data = await res.json();
            const logDiv = document.getElementById('reorgLog');
            const statusDiv = document.getElementById('reorgStatus');
            logDiv.textContent = data.logs.join('\\n');
            if (!data.running) {
                statusDiv.textContent = '✅ Completed';
                statusDiv.className = 'utility-status done';
                if (reorgInterval) {
                    clearInterval(reorgInterval);
                    reorgInterval = null;
                    document.getElementById('reorgBtn').disabled = false;
                    document.getElementById('reorgBtn').textContent = '🚀 Start Reorganize';
                }
            } else {
                statusDiv.textContent = '🔄 Running...';
                statusDiv.className = 'utility-status running';
                document.getElementById('reorgBtn').disabled = true;
                document.getElementById('reorgBtn').textContent = '🔄 Running...';
            }
            logDiv.scrollTop = logDiv.scrollHeight;
        } catch (_) {}
    }

    // ---------- Deduplicate ----------
    async function startDedup(action) {
        const target = document.getElementById('dedupTarget').value.trim();
        if (!target) { alert('Please enter a target folder.'); return; }
        const scanBtn = document.getElementById('dedupScanBtn');
        const delBtn = document.getElementById('dedupDeleteBtn');
        const logDiv = document.getElementById('dedupLog');
        const statusDiv = document.getElementById('dedupStatus');
        scanBtn.disabled = true;
        delBtn.disabled = true;
        logDiv.textContent = 'Running...';
        statusDiv.textContent = 'Running...';
        statusDiv.className = 'utility-status running';

        try {
            const response = await fetch('/deduplicate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ target: target, action: action })
            });
            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let result = '';
            while (true) {
                const { done, value } = await reader.read();
                if (done) break;
                const chunk = decoder.decode(value);
                result += chunk;
                logDiv.textContent = result;
                logDiv.scrollTop = logDiv.scrollHeight;
            }
            statusDiv.textContent = '✅ Completed';
            statusDiv.className = 'utility-status done';
        } catch (e) {
            logDiv.textContent = 'Error: ' + e;
            statusDiv.textContent = '❌ Error';
            statusDiv.className = 'utility-status failed';
        }
        scanBtn.disabled = false;
        delBtn.disabled = false;
    }

    // ---------- Metadata Updater ----------
    let currentMetadata = [];

    async function scanMetadata() {
        const path = document.getElementById('metadataPath').value.trim();
        if (!path) { alert('Please enter a folder path.'); return; }
        const statusDiv = document.getElementById('metadataStatus');
        statusDiv.textContent = 'Scanning...';
        try {
            const res = await fetch('/metadata/scan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ path: path })
            });
            const data = await res.json();
            if (data.error) {
                statusDiv.textContent = '❌ ' + data.error;
                return;
            }
            currentMetadata = data;
            statusDiv.textContent = `✅ Found ${data.length} files with metadata.`;
            renderMetadataList(data);
        } catch (e) {
            statusDiv.textContent = '❌ Error: ' + e;
        }
    }

    function renderMetadataList(items) {
        const container = document.getElementById('metadataList');
        if (!items.length) {
            container.innerHTML = '<p style="color:var(--text-muted);">No metadata files found.</p>';
            return;
        }
        let html = '';
        for (const item of items) {
            html += `
            <div class="metadata-item">
                <div>
                    <div class="title">${escapeHTML(item.title) || 'Untitled'}</div>
                    <div class="uploader">${escapeHTML(item.uploader) || 'Unknown'} · ${escapeHTML(item.upload_date) || ''}</div>
                </div>
                <div class="actions">
                    <button onclick="openEditModal('${encodeURIComponent(item.info_file)}')">✏️ Edit</button>
                </div>
            </div>
            `;
        }
        container.innerHTML = html;
    }

    function openEditModal(infoFile) {
        infoFile = decodeURIComponent(infoFile);
        const item = currentMetadata.find(i => i.info_file === infoFile);
        if (!item) return;
        document.getElementById('editInfoFile').value = infoFile;
        document.getElementById('editTitle').value = item.title || '';
        document.getElementById('editUploader').value = item.uploader || '';
        document.getElementById('editDate').value = item.upload_date || '';
        document.getElementById('editDescription').value = item.description || '';
        document.getElementById('editTags').value = (item.tags || []).join(', ');
        document.getElementById('editModal').classList.add('active');
    }

    function closeModal() {
        document.getElementById('editModal').classList.remove('active');
    }

    async function saveMetadata() {
        const infoFile = document.getElementById('editInfoFile').value;
        const data = {
            info_file: infoFile,
            title: document.getElementById('editTitle').value,
            uploader: document.getElementById('editUploader').value,
            upload_date: document.getElementById('editDate').value,
            description: document.getElementById('editDescription').value,
            tags: document.getElementById('editTags').value.split(',').map(s => s.trim()).filter(Boolean)
        };
        try {
            const res = await fetch('/metadata/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.status === 'updated') {
                alert('Metadata updated successfully!');
                closeModal();
                scanMetadata();
            } else {
                alert('Error: ' + (result.error || 'Unknown error'));
            }
        } catch (e) {
            alert('Error: ' + e);
        }
    }

    // ---------- Tmp Reorder ----------
    let tmpReorgInterval = null;
    async function startTmpReorg() {
        const btn = document.getElementById('tmpReorgBtn');
        btn.disabled = true;
        btn.textContent = '⏳ Starting...';
        const res = await fetch('/tmp-reorder', { method: 'POST' });
        const data = await res.json();
        if (data.status === 'already running') {
            alert('Already running.');
            btn.disabled = false;
            btn.textContent = '🚀 Reorder Tmp Files';
            return;
        }
        if (tmpReorgInterval) clearInterval(tmpReorgInterval);
        document.getElementById('tmpReorgLog').textContent = 'Loading logs...';
        document.getElementById('tmpReorgStatus').textContent = 'Running...';
        document.getElementById('tmpReorgStatus').className = 'utility-status running';
        tmpReorgInterval = setInterval(fetchTmpReorgLogs, 1500);
        fetchTmpReorgLogs();
        btn.textContent = '🔄 Running...';
    }

    async function fetchTmpReorgLogs() {
        try {
            const res = await fetch('/tmp-reorder-logs');
            const data = await res.json();
            const logDiv = document.getElementById('tmpReorgLog');
            const statusDiv = document.getElementById('tmpReorgStatus');
            logDiv.textContent = data.logs.join('\\n');
            if (!data.running) {
                statusDiv.textContent = '✅ Completed';
                statusDiv.className = 'utility-status done';
                if (tmpReorgInterval) {
                    clearInterval(tmpReorgInterval);
                    tmpReorgInterval = null;
                    document.getElementById('tmpReorgBtn').disabled = false;
                    document.getElementById('tmpReorgBtn').textContent = '🚀 Reorder Tmp Files';
                }
            } else {
                statusDiv.textContent = '🔄 Running...';
                statusDiv.className = 'utility-status running';
                document.getElementById('tmpReorgBtn').disabled = true;
                document.getElementById('tmpReorgBtn').textContent = '🔄 Running...';
