@app.route("/reorganize", methods=["POST"])
def reorganize():
    global REORG_RUNNING, REORG_LOGS, REORG_MOVED_DIRS
    with REORG_LOCK:
        if REORG_RUNNING:
            return jsonify({"status": "already running"}), 400
        REORG_RUNNING = True
        REORG_LOGS = []
        REORG_MOVED_DIRS = []
    def run_reorg():
        global REORG_RUNNING, REORG_LOGS, REORG_MOVED_DIRS
        try:
            settings = load_settings()
            env = os.environ.copy()
            env["REORG_YT_DIR"] = settings.get("yt_base_path", DEFAULT_YT_DIR)
            env["REORG_MUSIC_DIR"] = settings.get("music_base_path", DEFAULT_MUSIC_DIR)
            env["REORG_GALLERY_DIR"] = settings.get("gallery_base_path", DEFAULT_GALLERY_DIR)
            proc = subprocess.Popen(
                ["/usr/local/bin/reorganize-youtube"],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                env=env
            )
            for line in proc.stdout:
                line = line.strip()
                with REORG_LOCK:
                    REORG_LOGS.append(line)
                    if line.startswith("MOVED_TO:"):
                        moved_dir = line.split("MOVED_TO:", 1)[1].strip()
                        if moved_dir not in REORG_MOVED_DIRS:
                            REORG_MOVED_DIRS.append(moved_dir)
                time.sleep(0.1)
            proc.wait()
        except Exception as e:
            with REORG_LOCK:
                REORG_LOGS.append(f"❌ Error: {e}")
        finally:
            with REORG_LOCK:
                REORG_RUNNING = False
                for dir_path in REORG_MOVED_DIRS:
                    refresh_library(dir_path)
                refresh_library("/media/YouTube")
    threading.Thread(target=run_reorg, daemon=True).start()
    return jsonify({"status": "started"})

