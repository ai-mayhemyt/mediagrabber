def save_auth(data):
    os.makedirs(os.path.dirname(AUTH_FILE), exist_ok=True)
    tmp = AUTH_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, AUTH_FILE)
    try:
        os.chmod(AUTH_FILE, 0o600)
    except OSError:
        pass

def _auth_required():
    endpoint = request.endpoint or ""
    if endpoint in ("login_page", "login_submit", "logout", "static"):
        return None
    if load_auth() is None:
        return None
    if session.get("user"):
        return None
    accept = request.accept_mimetypes.best_match(["text/html", "application/json", "*/*"])
    if request.path == "/" or request.path.startswith("/log/") or accept == "text/html":
        return redirect(url_for("login_page", next=request.full_path.rstrip("?")))
    return jsonify({"error": "authentication required"}), 401

