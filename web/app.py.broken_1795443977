@app.route("/cancel/<job_id>", methods=["POST"])
def cancel_job(job_id):
    with LOCK:
        if job_id in PROCESSES:
            try:
                PROCESSES[job_id].terminate()
                append_log(job_id, "🛑 Job cancelled by user")
                time.sleep(1)
                if PROCESSES[job_id].poll() is None:
                    PROCESSES[job_id].kill()
            except Exception as e:
                append_log(job_id, f"⚠️ Cancel error: {e}")
            finally:
                if job_id in PROCESSES:
                    del PROCESSES[job_id]
        if job_id in QUEUE:
            QUEUE[job_id]["status"] = "cancelled"
            QUEUE[job_id]["progress"] = 0
    return jsonify({"status": "cancelled"})

