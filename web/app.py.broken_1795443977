    <script>
    const presets = {
        'default': { bg: '#0f0f11', sidebar: '#141418', card: '#1a1a20', text: '#eaeef2', accent: '#5b7cfa', border: '#2c2c36' },
        'light': { bg: '#f4f5f7', sidebar: '#e5e7eb', card: '#ffffff', text: '#1a1a20', accent: '#0066cc', border: '#d1d5db' },
        'cyberpunk': { bg: '#0a001a', sidebar: '#12002b', card: '#1a0033', text: '#00ffff', accent: '#ff00ff', border: '#ff00ff' },
        'christmas': { bg: '#061a0d', sidebar: '#03210e', card: '#0a2e17', text: '#ffffff', accent: '#ff3333', border: '#2e8b57' },
        'halloween': { bg: '#1a0f00', sidebar: '#140c00', card: '#2b1800', text: '#ffcc00', accent: '#ff6600', border: '#4d2800' },
        'birthday': { bg: '#1a0a1a', sidebar: '#140014', card: '#2e0e2e', text: '#ffffff', accent: '#ff66b2', border: '#ffcc00' },
        'midnight': { bg: '#0a1128', sidebar: '#070c1c', card: '#121e42', text: '#e0e7ff', accent: '#4f46e5', border: '#1e2d5a' },
        'forest': { bg: '#0b1a12', sidebar: '#06120c', card: '#122b1e', text: '#d1fae5', accent: '#10b981', border: '#1e3f2c' },
        'sunset': { bg: '#2b120e', sidebar: '#1f0d0a', card: '#421a14', text: '#ffedd5', accent: '#f97316', border: '#5e2419' },
        'matrix': { bg: '#000000', sidebar: '#050505', card: '#0a0a0a', text: '#00ff00', accent: '#00aa00', border: '#004400' }
    };

    function loadPreset() {
        const val = document.getElementById('themePreset').value;
        
        const presets = {
            'default': { bg: '#0f0f11', sidebar: '#1a1a20', card: '#1a1a20', border: '#2c2c36', text: '#eaeef2', accent: '#5b7cfa' },
            'light': { bg: '#f5f7fc', sidebar: '#ffffff', card: '#ffffff', border: '#d0d7e6', text: '#1e2230', accent: '#5b7cfa' },
            'cyberpunk': { bg: '#0a0a0a', sidebar: '#111111', card: '#000000', border: '#00ff00', text: '#00ff00', accent: '#ff00ff' },
            'nord': { bg: '#2e3440', sidebar: '#3b4252', card: '#434c5e', border: '#4c566a', text: '#d8dee9', accent: '#88c0d0' },
            'dracula': { bg: '#282a36', sidebar: '#21222c', card: '#44475a', border: '#6272a4', text: '#f8f8f2', accent: '#bd93f9' },
            'solarized': { bg: '#002b36', sidebar: '#073642', card: '#073642', border: '#586e75', text: '#839496', accent: '#b58900' },
            'rosepine': { bg: '#191724', sidebar: '#1f1d2e', card: '#26233a', border: '#403d52', text: '#e0def4', accent: '#ebbcba' },
            'amoled': { bg: '#000000', sidebar: '#000000', card: '#0a0a0a', border: '#1a1a1a', text: '#ffffff', accent: '#5b7cfa' }
        };
        if (presets[val]) {
            document.getElementById('theme-bg').value = presets[val].bg;
            document.getElementById('theme-sidebar').value = presets[val].sidebar;
            document.getElementById('theme-card').value = presets[val].card;
            document.getElementById('theme-border').value = presets[val].border;
            document.getElementById('theme-text').value = presets[val].text;
            document.getElementById('theme-accent').value = presets[val].accent;
        }

        const selected = document.getElementById('themePreset').value;
        if (selected === 'custom') return;
        const colors = presets[selected];
        if (!colors) return;
        document.getElementById('theme-bg').value = colors.bg;
        document.getElementById('theme-sidebar').value = colors.sidebar;
        document.getElementById('theme-card').value = colors.card;
        document.getElementById('theme-text').value = colors.text;
        document.getElementById('theme-accent').value = colors.accent;
        document.getElementById('theme-border').value = colors.border;
    }

    // Load saved colors on page load
    document.addEventListener('DOMContentLoaded', () => {
        const c = getComputedStyle(document.documentElement);
        document.getElementById('theme-bg').value = c.getPropertyValue('--bg').trim() || '#0f0f11';
        document.getElementById('theme-sidebar').value = c.getPropertyValue('--sidebar').trim() || '#141418';
        document.getElementById('theme-card').value = c.getPropertyValue('--card').trim() || '#1a1a20';
        document.getElementById('theme-text').value = c.getPropertyValue('--text').trim() || '#eaeef2';
        document.getElementById('theme-accent').value = c.getPropertyValue('--accent').trim() || '#5b7cfa';
        document.getElementById('theme-border').value = c.getPropertyValue('--border').trim() || '#2c2c36';
        updateCustomDropdown();
    });

    function getCurrentColors() {
        return {
            'bg': document.getElementById('theme-bg').value,
            'sidebar': document.getElementById('theme-sidebar').value,
            'card': document.getElementById('theme-card').value,
            'text': document.getElementById('theme-text').value,
            'accent': document.getElementById('theme-accent').value,
            'border': document.getElementById('theme-border').value
        };
    }

    function applyAndSave(colors) {
        fetch('/api/theme', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({colors: colors})
        }).then(r => r.json()).then(d => {
            if(d.success) {
                for (const [k, v] of Object.entries(colors)) {
                    document.documentElement.style.setProperty('--' + k, v);
                }
                document.getElementById('themeModal').style.display='none';
            } else { alert('Error saving theme'); }
        });
    }

    function saveTheme() { applyAndSave(getCurrentColors()); }

    function resetTheme() {
        applyAndSave(presets['default']);
        document.getElementById('themePreset').value = 'default';
        loadPreset();
    }

    // --- Custom Presets Logic ---
    function saveCustomPreset() {
        const name = document.getElementById('customThemeName').value.trim();
        if (!name) return alert('Please enter a name');
        const customs = JSON.parse(localStorage.getItem('mg_custom_themes') || '{}');
        customs[name] = getCurrentColors();
        localStorage.setItem('mg_custom_themes', JSON.stringify(customs));
        document.getElementById('customThemeName').value = '';
        updateCustomDropdown();
        alert('Custom theme saved!');
    }

    function updateCustomDropdown() {
        const customs = JSON.parse(localStorage.getItem('mg_custom_themes') || '{}');
        const sel = document.getElementById('customPresetsList');
        sel.innerHTML = '<option value="">-- Load Custom Theme --</option>';
        for (const name in customs) {
            sel.innerHTML += `<option value="${name}">${name}</option>`;
        }
    }

    function loadCustomPreset() {
        const name = document.getElementById('customPresetsList').value;
        if (!name) return;
        const customs = JSON.parse(localStorage.getItem('mg_custom_themes') || '{}');
        const colors = customs[name];
        if (!colors) return;
        document.getElementById('theme-bg').value = colors.bg;
        document.getElementById('theme-sidebar').value = colors.sidebar;
        document.getElementById('theme-card').value = colors.card;
        document.getElementById('theme-text').value = colors.text;
        document.getElementById('theme-accent').value = colors.accent;
        document.getElementById('theme-border').value = colors.border;
        document.getElementById('themePreset').value = 'custom';
    }
    </script>
