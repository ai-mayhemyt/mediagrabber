@app.route("/api/storage", methods=["GET"])
def get_storage():
    import shutil, os
    settings = load_settings()
    # Use the user's actual configured paths
    paths = {
        "Video": settings.get("yt_base_path", "/media/YouTube"),
        "Music": settings.get("music_base_path", "/media/christopher/media-12/Music"),
        "Gallery": settings.get("gallery_base_path", "/media/Gallery")
    }
    result = {}
    for name, path in paths.items():
        if os.path.exists(path):
            try:
                total, used, free = shutil.disk_usage(path)
                result[name] = {
                    "free_gb": round(free / (1024**3), 1),
                    "total_gb": round(total / (1024**3), 1),
                    "percent_used": round((used / total) * 100, 1)
                }
            except Exception:
                result[name] = {"error": "Permission denied"}
        else:
            result[name] = {"error": "Path not found"}
    return jsonify(result)





THUMBS_CACHE_PATH = "/opt/mediagrabber/thumbs.json"

def _load_thumbs():
    try:
        if os.path.exists(THUMBS_CACHE_PATH):
            with open(THUMBS_CACHE_PATH, "r") as f:
                return json.load(f)
    except Exception:
        pass
    return {}

def _save_thumbs(cache):
    try:
        tmp = THUMBS_CACHE_PATH + ".tmp"
        with open(tmp, "w") as f:
            json.dump(cache, f)
        os.replace(tmp, THUMBS_CACHE_PATH)
    except Exception as e:
        print(f"thumbs cache save error: {e}", file=sys.stderr)

def resolve_thumbnail(url, source_type, cache):
    """Return (title, thumb_url) for an archive URL, using & updating cache[url]."""
    key = url
    if key in cache and isinstance(cache[key], dict):
        return cache[key].get("title") or "Archived Entry", cache[key].get("thumb") or ""

    title, thumb = "Archived Entry", ""

    if source_type in ("youtube", "ytmusic"):
        try:
            # Use the explicit path to avoid PATH issues in systemd, and increase timeout
            ytdlp_bin = os.path.expanduser("~/.local/bin/yt-dlp")
            if not os.path.exists(ytdlp_bin):
                ytdlp_bin = "yt-dlp"
            
            res = subprocess.run(
                [ytdlp_bin, "--dump-json", "--skip-download", "--no-warnings", url],
                capture_output=True, text=True, timeout=30)
            if res.returncode == 0:
                info = json.loads(res.stdout)
                title = info.get("title", title)
                thumb = info.get("thumbnail", "")
            else:
                print(f"yt-dlp failed for {url}: {res.stderr}", file=sys.stderr)
        except Exception as e:
            print(f"yt-dlp exception for {url}: {e}", file=sys.stderr)

    elif source_type == "spotify":
        try:
            import urllib.request
            oembed = "https://open.spotify.com/oembed?url=" + urllib.parse.quote(url, safe="")
            req = urllib.request.Request(oembed, headers={"User-Agent": "MediaGrabber/2.0"})
            with urllib.request.urlopen(req, timeout=5) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                thumb = data.get("thumbnail_url", "") or ""
                title = data.get("title", title) or title
        except Exception:
            pass

    # Gallery: leave empty (auth-required for IG/TikTok previews)

    cache[key] = {"title": title, "thumb": thumb}
    return title, thumb

@app.route("/api/history", methods=["GET"])
def get_history():
    history_items = []
    seen_ids = set()

    def _src(url):
        u = (url or "").lower()
        if "music.youtube.com" in u: return "ytmusic"
        if "youtube.com" in u or "youtu.be" in u: return "youtube"
        if "spotify.com" in u: return "spotify"
        if "instagram.com" in u or "tiktok.com" in u: return "gallery"
        return "other"

    try:
        conn = sqlite3.connect(USER_DB_PATH)
        conn.row_factory = sqlite3.Row
        rows = conn.execute("SELECT * FROM history ORDER BY timestamp DESC LIMIT 100").fetchall()
        for r in rows:
            history_items.append({
                "url": r["url"],
                "title": r["filename"],
                "thumbnail": "",
                "timestamp": r["timestamp"],
                "source": _src(r["url"]),
            })
            seen_ids.add(r["url"])
            seen_ids.add(r["url"].rsplit("=", 1)[-1].rsplit("/", 1)[-1])
        conn.close()
    except Exception as e:
        print("db history error:", e, file=sys.stderr)

    try:
        archive_lines = get_archive_contents() or []
    except Exception:
        archive_lines = []

    _thumbs = _load_thumbs()
    _thumbs_dirty = False
    _thumbs_before = dict(_thumbs)
    for line in archive_lines:
        source_type, url = parse_archive_line(line)
        if source_type is None:
            continue
        vid = url.rsplit("=", 1)[-1].rsplit("/", 1)[-1]
        if url in seen_ids or vid in seen_ids:
            continue
        seen_ids.add(url)
        seen_ids.add(vid)
        title, thumb = resolve_thumbnail(url, source_type, _thumbs)
        history_items.append({
            "url": url,
            "title": title,
            "thumbnail": thumb,
            "timestamp": "Unknown",
            "source": source_type,
        })
    if _thumbs != _thumbs_before:
        _save_thumbs(_thumbs)

    return jsonify(history_items)

