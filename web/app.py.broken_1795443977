        if (res.ok && res.body.ok) {
            _setNetwatchMsg(res.body.message || 'Done', 'ok');
            setTimeout(function() { loadServerManager(true); }, 1000);
        } else {
            _setNetwatchMsg('Error: ' + (res.body.error || 'unknown'), 'error');
        }
    })
    .catch(function(err) {
