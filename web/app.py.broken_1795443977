def init_user_db():
    conn = sqlite3.connect(USER_DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("""CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        username TEXT UNIQUE NOT NULL,
        password_hash TEXT NOT NULL,
        display_name TEXT,
        role TEXT DEFAULT 'user',
        avatar TEXT,
        email TEXT,
        reset_token TEXT,
        reset_expires REAL,
        theme TEXT DEFAULT 'dark',
        totp_secret TEXT
    )""")
    try:
        conn.execute("ALTER TABLE users ADD COLUMN totp_secret TEXT")
    except sqlite3.OperationalError:
        pass
    try:
        conn.execute("ALTER TABLE users ADD COLUMN theme TEXT DEFAULT 'dark'")
    except sqlite3.OperationalError:
        pass
    conn.commit()
    
    if conn.execute("SELECT COUNT(*) FROM users").fetchone()[0] == 0:
        old_auth = load_auth_json()
        if old_auth:
            conn.execute(
                "INSERT INTO users (username, password_hash, display_name, role) VALUES (?, ?, ?, ?)",
                (old_auth["username"], old_auth["password_hash"], old_auth["username"], "admin")
            )
        else:
            conn.execute(
                "INSERT INTO users (username, password_hash, display_name, role) VALUES (?, ?, ?, ?)",
                ("admin", generate_password_hash("admin"), "Administrator", "admin")
            )
        conn.commit()
    conn.close()

